\begin{Verbatim}[commandchars=\\\{\}]
set(\nspstring{"figure_style"},\nspstring{"new"})\nspoperator{,}\nspcomment{//create a figure}
a=get(\nspstring{"current_axes"})\nspoperator{;}
a.data_bounds=[\nspoperator{-}\nspnumber{2}\nspoperator{,}\nspoperator{-}\nspnumber{4}\nspoperator{;}\nspnumber{2}\nspoperator{,}\nspnumber{4}]\nspoperator{;}
a.axes_visible=\nspstring{"on"}\nspoperator{;}
a.box=\nspstring{"off"}\nspoperator{;}
xtitle([\nspstring{'Titre'}\nspoperator{;}\nspstring{'Principal'}],\nspstring{'x'},\nspstring{'y'})\nspoperator{;}
t=a.title\nspoperator{;}
t.text\nspoperator{,}\nspcomment{//display text on console}
t.font_size=\nspnumber{4}\nspoperator{;}
t.text=\nspstring{"A brand new@title string"}
t.font_style=\nspnumber{5}\nspoperator{;}
a.x_location=\nspstring{"middle"}\nspoperator{;}
a.y_location=\nspstring{"right"}\nspoperator{;}
\end{Verbatim}
