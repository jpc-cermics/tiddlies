\begin{Verbatim}[commandchars=\\\{\}]
l=list(\nspnumber{1},[\nspstring{"a"}\nspoperator{,}\nspstring{"b"}])
l(\nspnumber{0})=\nspstring{"foo"}
l($\nspoperator{+}\nspnumber{1})=\nspstring{"bar"}
l(\nspnumber{2})=\nspstring{"toto"}
l(\nspnumber{3})=rand(\nspnumber{1},\nspnumber{2})
l(\nspnumber{3})=null()
lbis=list(\nspstring{"gewurtz"},\nspstring{"caipirina"},\nspstring{"debug"})
lter=lstcat(l,lbis)
size(lter)\nspoperator{-}size(lbis)\nspoperator{-}size(l)\nspoperator{,}\nspcomment{// must be zero}
\end{Verbatim}
