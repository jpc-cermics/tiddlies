\begin{Verbatim}[commandchars=\\\{\}]
f=figure(\nspstring{'position'},[\nspnumber{10}\nspoperator{,}\nspnumber{10}\nspoperator{,}\nspnumber{300}\nspoperator{,}\nspnumber{200}])\nspoperator{;}
\nspcomment{// create a figure}
m=uimenu(f,\nspstring{'label'},\nspstring{'windows'})\nspoperator{;}
\nspcomment{// create an item on the menu bar}
m1=uimenu(m,\nspstring{'label'},\nspstring{'operations'})\nspoperator{;}
m2=uimenu(m,\nspstring{'label'},\nspstring{'quit scilab'},\nspstring{'callback'},\nspstring{"exit"})\nspoperator{;}
\nspcomment{//create two items in the menu "windows"}
m11=uimenu(m1,\nspstring{'label'},\nspstring{'new window'},\nspstring{'callback'},\nspstring{"xselect()"})\nspoperator{;}
m12=uimenu(m1,\nspstring{'label'},\nspstring{'clear  window'},\nspstring{'callback'},\nspstring{"xbasc()"})\nspoperator{;}
\nspcomment{// create a submenu to the item "operations"}
close(f)\nspoperator{;}
\nspcomment{// close the figure}
\end{Verbatim}
