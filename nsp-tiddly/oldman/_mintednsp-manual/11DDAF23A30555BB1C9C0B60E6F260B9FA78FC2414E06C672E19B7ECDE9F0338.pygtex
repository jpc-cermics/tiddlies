\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{//Decode ole file, extract and open Excel stream}
[fd,SST,Sheetnames,Sheetpos]=xls_open(\nspstring{'SCI/demos/excel/Test1.xls'})
\nspcomment{//Read first data sheet}
[Value,TextInd]=xls_read(fd,Sheetpos(\nspnumber{1}))
\nspcomment{//close the excel stream}
mclose(fd)
\end{Verbatim}
