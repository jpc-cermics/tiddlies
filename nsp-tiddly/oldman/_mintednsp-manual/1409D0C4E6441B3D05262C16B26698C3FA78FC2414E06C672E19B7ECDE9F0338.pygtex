\begin{Verbatim}[commandchars=\\\{\}]
x=poly(\nspnumber{0},\nspstring{'x'})\nspoperator{;}
p1=(\nspnumber{1}\nspoperator{+}x\nspoperator{^}\nspnumber{2})\nspoperator{*}(\nspnumber{1}\nspoperator{-}x)\nspoperator{;}p2=\nspnumber{1}\nspoperator{-}x\nspoperator{;}
[r,q]=pdiv(p1,p2)
p2\nspoperator{*}q\nspoperator{-}p1
p2=\nspnumber{1}\nspoperator{+}x\nspoperator{;}
[r,q]=pdiv(p1,p2)
p2\nspoperator{*}q\nspoperator{+}r\nspoperator{-}p1
