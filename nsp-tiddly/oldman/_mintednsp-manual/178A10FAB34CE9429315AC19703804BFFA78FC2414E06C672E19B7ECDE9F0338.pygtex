\begin{Verbatim}[commandchars=\\\{\}]
x=linspace(\nspoperator{-}\nspnumber{2}\nspoperator{*}%pi,\nspnumber{2}\nspoperator{*}%pi,\nspnumber{100})\nspoperator{'}\nspoperator{;}
plot2d(x,[sin(x)\nspoperator{,}cos(x)])\nspoperator{;}
e=gce()\nspoperator{;}p1=e.children(\nspnumber{1})\nspoperator{;}p2=e.children(\nspnumber{2})\nspoperator{;}
\nspcomment{// cos plot twinkle}
twinkle(p1)
\nspcomment{// sin plot twinkle 10 times}
twinkle(p2,\nspnumber{10})
\nspcomment{// axes twinkle}
twinkle(gca())
\end{Verbatim}
