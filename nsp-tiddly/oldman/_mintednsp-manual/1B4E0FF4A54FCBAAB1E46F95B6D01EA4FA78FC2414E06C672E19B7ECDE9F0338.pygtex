\begin{Verbatim}[commandchars=\\\{\}]
plot2d(\nspnumber{1}\nspoperator{:}\nspnumber{10},\nspnumber{1}\nspoperator{:}\nspnumber{10},\nspnumber{1},\nspstring{"020"})
\nspcomment{// horizontal axis}
drawaxis(x = \nspnumber{2}\nspoperator{:}\nspnumber{7},y = \nspnumber{4},dir = \nspstring{'u'},tics = \nspstring{'v'})
\nspcomment{// horizontal axis on top of the frame}
drawaxis(x = \nspnumber{2}\nspoperator{:}\nspnumber{7},dir = \nspstring{'u'},tics = \nspstring{'v'})
\nspcomment{// horizontal axis at the bottom of the frame}
drawaxis(x = \nspnumber{2}\nspoperator{:}\nspnumber{7},dir = \nspstring{'d'},tics = \nspstring{'v'})
\nspcomment{// horizontal axis given by a range}
drawaxis(x = [\nspnumber{2}\nspoperator{,}\nspnumber{7}\nspoperator{,}\nspnumber{3}],y = \nspnumber{4},dir = \nspstring{'d'},tics = \nspstring{'r'})
\nspcomment{// vertical axis}
drawaxis(x = \nspnumber{4},y = \nspnumber{2}\nspoperator{:}\nspnumber{7},dir = \nspstring{'r'},tics = \nspstring{'v'})
drawaxis(x = \nspnumber{2},y = [\nspnumber{2}\nspoperator{,}\nspnumber{7}\nspoperator{,}\nspnumber{3}],dir = \nspstring{'l'},tics = \nspstring{'r'})
drawaxis(y = \nspnumber{2}\nspoperator{:}\nspnumber{7},dir = \nspstring{'r'},tics = \nspstring{'v'})
drawaxis(y = \nspnumber{2}\nspoperator{:}\nspnumber{7},dir = \nspstring{'l'},tics = \nspstring{'v'})
\nspcomment{// horizontal axis with strings displayed at tics positions}
drawaxis(x = \nspnumber{2}\nspoperator{:}\nspnumber{7},y = \nspnumber{8},dir = \nspstring{'u'},tics = \nspstring{'v'},val = \nspstring{'A'}\nspoperator{+}string(\nspnumber{1}\nspoperator{:}\nspnumber{6}))\nspoperator{;}
\nspcomment{// vertical axis with strings displayed at tics positions}
drawaxis(x = \nspnumber{8},y = \nspnumber{2}\nspoperator{:}\nspnumber{7},dir = \nspstring{'r'},tics = \nspstring{'v'},val = \nspstring{'B'}\nspoperator{+}string(\nspnumber{1}\nspoperator{:}\nspnumber{6}))\nspoperator{;}
\nspcomment{// horizontal axis given with a 'i' range.}
drawaxis(x = [\nspnumber{2}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{3}],y = \nspnumber{9},dir = \nspstring{'u'},tics = \nspstring{'i'})\nspoperator{;}
drawaxis(x = \nspnumber{9},y = [\nspnumber{2}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{3}],dir = \nspstring{'r'},tics = \nspstring{'i'},sub_int = \nspnumber{5})\nspoperator{;}
\nspcomment{// horizontal axis again}
drawaxis(x = \nspnumber{2}\nspoperator{:}\nspnumber{7},y = \nspnumber{4},dir = \nspstring{'u'},tics = \nspstring{'v'},fontsize = \nspnumber{10},textcolor = \nspnumber{9},ticscolor = \nspnumber{7}, ...
         seg = \nspnumber{0},sub_int = \nspnumber{20})
\end{Verbatim}
