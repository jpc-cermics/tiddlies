\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// see the examples of splin2d}
\nspcomment{// this example shows some different extrapolation features}
\nspcomment{// interpolation of cos(x)cos(y)}
n=\nspnumber{7}\nspoperator{;}\nspcomment{// a n x n interpolation grid}
x=linspace(\nspnumber{0},\nspnumber{2}\nspoperator{*}%pi,n)\nspoperator{;}y=x\nspoperator{;}
z=cos(x\nspoperator{'})\nspoperator{*}cos(y)\nspoperator{;}
C=splin2d(x,y,z,\nspstring{"periodic"})\nspoperator{;}
\nspcomment{// now evaluate on a bigger domain than [0,2pi]x [0,2pi]}
m=\nspnumber{80}\nspoperator{;}\nspcomment{// discretisation parameter of the evaluation grid}
xx=linspace(\nspoperator{-}\nspnumber{0.5}\nspoperator{*}%pi,\nspnumber{2.5}\nspoperator{*}%pi,m)\nspoperator{;}yy=xx\nspoperator{;}
[XX,YY]=ndgrid(xx,yy)\nspoperator{;}
zz1=interp2d(XX,YY,x,y,C,\nspstring{"C0"})\nspoperator{;}
zz2=interp2d(XX,YY,x,y,C,\nspstring{"by_zero"})\nspoperator{;}
zz3=interp2d(XX,YY,x,y,C,\nspstring{"periodic"})\nspoperator{;}
zz4=interp2d(XX,YY,x,y,C,\nspstring{"natural"})\nspoperator{;}
xbasc()
subplot(\nspnumber{2},\nspnumber{2},\nspnumber{1})
plot3d(xx,yy,zz1,flag = [\nspnumber{2}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{4}])
xtitle(\nspstring{"extrapolation with the C0 outmode"})
subplot(\nspnumber{2},\nspnumber{2},\nspnumber{2})
plot3d(xx,yy,zz2,flag = [\nspnumber{2}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{4}])
xtitle(\nspstring{"extrapolation with the by_zero outmode"})
subplot(\nspnumber{2},\nspnumber{2},\nspnumber{3})
plot3d(xx,yy,zz3,flag = [\nspnumber{2}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{4}])
xtitle(\nspstring{"extrapolation with the periodic outmode"})
subplot(\nspnumber{2},\nspnumber{2},\nspnumber{4})
plot3d(xx,yy,zz4,flag = [\nspnumber{2}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{4}])
xtitle(\nspstring{"extrapolation with the natural outmode"})
xselect()
\end{Verbatim}
