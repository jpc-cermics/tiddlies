\begin{Verbatim}[commandchars=\\\{\}]
hz=iir(\nspnumber{3},\nspstring{'bp'},\nspstring{'ellip'},[\nspnumber{.15}\nspoperator{,}\nspnumber{.25}],[\nspnumber{.08}\nspoperator{,}\nspnumber{.03}])\nspoperator{;}
[hzm,fr]=frmag(hz,\nspnumber{256})\nspoperator{;}
plot2d(fr\nspoperator{'},hzm\nspoperator{'})
xtitle(\nspstring{'Discrete IIR filter band pass  0.15$&lt;$fr$&lt;$0.25 '},\nspstring{' '},\nspstring{' '})\nspoperator{;}
q=poly(\nspnumber{0},\nspstring{'q'})\nspoperator{;}\nspcomment{//to express the result in terms of the ...}
hzd=horner(hz,\nspnumber{1}\nspoperator{/}q)\nspoperator{,}\nspcomment{//delay operator q=z^-1}
\end{Verbatim}
