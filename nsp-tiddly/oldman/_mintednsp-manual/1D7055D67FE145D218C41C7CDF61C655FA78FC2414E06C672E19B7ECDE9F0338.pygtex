\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// MATRIX CASE}
a=[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{3}\nspoperator{;}\nspnumber{4}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{6}]
a(\nspnumber{1},\nspnumber{2})
a([\nspnumber{1}\nspoperator{,}\nspnumber{1}],\nspnumber{2})
a(\nspoperator{:},\nspnumber{1})
a(\nspoperator{:},\nspnumber{3}\nspoperator{:}\nspoperator{-}\nspnumber{1}\nspoperator{:}\nspnumber{1})
a(\nspnumber{1})
a(\nspnumber{6})
a(\nspoperator{:})
a([%t\nspoperator{,}%f\nspoperator{,}%f\nspoperator{,}%t])
a([%t\nspoperator{,}%f],[\nspnumber{2}\nspoperator{,}\nspnumber{3}])
a(\nspnumber{1}\nspoperator{:}\nspnumber{2},$\nspoperator{-}\nspnumber{1})
a($\nspoperator{:}\nspoperator{-}\nspnumber{1}\nspoperator{:}\nspnumber{1},\nspnumber{2})
a($)
\nspcomment{//}
x=\nspstring{'test'}
x([\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{;}\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{;}\nspnumber{1}\nspoperator{,}\nspnumber{1}])
\nspcomment{//}
b=[\nspnumber{1}\nspoperator{/}%s\nspoperator{,}(%s\nspoperator{+}\nspnumber{1})\nspoperator{/}(%s\nspoperator{-}\nspnumber{1})]
b(\nspnumber{1},\nspnumber{1})
b(\nspnumber{1},$)
b(\nspnumber{2})\nspoperator{,}\nspcomment{// the numerator}
\nspcomment{// LIST OR TLIST CASE}
l=list(\nspnumber{1},\nspstring{'qwerw'},%s)
l(\nspnumber{1})
[a,b]=l([\nspnumber{3}\nspoperator{,}\nspnumber{2}])
l($)
x=tlist(l(\nspnumber{2}\nspoperator{:}\nspnumber{3}))\nspoperator{,}\nspcomment{//form a tlist with the last 2 components of l}
\nspcomment{//}
dts=list(\nspnumber{1},tlist([\nspstring{'x'}\nspoperator{;}\nspstring{'a'}\nspoperator{;}\nspstring{'b'}],\nspnumber{10},[\nspnumber{2}\nspoperator{,}\nspnumber{3}]))\nspoperator{;}
dts(\nspnumber{2})(\nspstring{'a'})
dts(\nspnumber{2})(\nspstring{'b'})(\nspnumber{1},\nspnumber{2})
[a,b]=dts(\nspnumber{2})([\nspstring{'a'}\nspoperator{,}\nspstring{'b'}])
\end{Verbatim}
