\begin{Verbatim}[commandchars=\\\{\}]
f=figure()\nspoperator{;}
\nspcomment{// create a figure}
h=uicontrol(f,\nspstring{'style'},\nspstring{'listbox'},\nspstring{'position'},[\nspnumber{10}\nspoperator{,}\nspnumber{10}\nspoperator{,}\nspnumber{150}\nspoperator{,}\nspnumber{160}])\nspoperator{;}
\nspcomment{// create a listbox}
set(h,\nspstring{'string'},\nspstring{"item 1|item 2|item3"})\nspoperator{;}
\nspcomment{// fill the list}
set(h,\nspstring{'value'},[\nspnumber{1}\nspoperator{,}\nspnumber{3}])\nspoperator{;}
\nspcomment{// select item 1 and 3 in the list}
close()\nspoperator{;}
\nspcomment{// close the figure}
f=figure()\nspoperator{;}
\nspcomment{// create a figure}
h=uicontrol(f,\nspstring{'style'},\nspstring{'listbox'},\nspstring{'position'},[\nspnumber{10}\nspoperator{,}\nspnumber{10}\nspoperator{,}\nspnumber{150}\nspoperator{,}\nspnumber{160}])\nspoperator{;}
\nspcomment{// create a listbox}
set(h,\nspstring{'string'},\nspstring{"item 1|item 2|item3"})\nspoperator{;}
\nspcomment{// fill the list}
set(h,\nspstring{'value'},[\nspnumber{1}\nspoperator{,}\nspnumber{3}])\nspoperator{;}
\nspcomment{// select (highlight) the item 1 and 3 in the list}
close()\nspoperator{;}
\nspcomment{//close the figure}
\end{Verbatim}
