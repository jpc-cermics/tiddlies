\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// dir}
\nspcomment{// dir SCI/macros/util/*.sci}
x=dir(\nspstring{'SCI/macros/util/f*.sci'})
dt=getdate(x.date)\nspoperator{;}
mprintf(\nspstring{"\nsppc{}s: \nsppc{}d-\nsppc{}d-\nsppc{}d \nsppc{}d:\nsppc{}d:\nsppc{}d\nspbs{}n"},x.name,dt(\nspoperator{:},[\nspnumber{3}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{7}\nspoperator{:}\nspnumber{9}]))
\end{Verbatim}
