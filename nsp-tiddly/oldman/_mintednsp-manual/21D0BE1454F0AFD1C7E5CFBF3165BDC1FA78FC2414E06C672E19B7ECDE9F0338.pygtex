\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// first subwindow}
xsetech([\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1.0}\nspoperator{,}\nspnumber{0.5}])
plot2d()
\nspcomment{// then xsetech is used to set the second sub window}
xsetech([\nspnumber{0}\nspoperator{,}\nspnumber{0.5}\nspoperator{,}\nspnumber{1.0}\nspoperator{,}\nspnumber{0.5}])
grayplot()
\nspcomment{// get the graphic scales of first subwindow}
xsetech([\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1.0}\nspoperator{,}\nspnumber{0.5}])
[wrect,frect,logflag,arect]=xgetech()\nspoperator{;}
\nspcomment{// get the graphic scales of second subwindow}
xsetech([\nspnumber{0}\nspoperator{,}\nspnumber{0.5}\nspoperator{,}\nspnumber{1.0}\nspoperator{,}\nspnumber{0.5}])
[wrect,frect,logflag,arect]=xgetech()\nspoperator{;}
xbasc()\nspoperator{;}
xset(\nspstring{'default'})
\end{Verbatim}
