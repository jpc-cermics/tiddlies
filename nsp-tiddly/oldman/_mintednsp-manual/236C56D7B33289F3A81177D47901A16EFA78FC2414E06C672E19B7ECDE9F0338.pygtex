\begin{Verbatim}[commandchars=\\\{\}]
f4=scf(\nspnumber{4})\nspoperator{;}\nspcomment{//creates figure with id==4 and make it the current one}
f0=scf(\nspnumber{0})\nspoperator{;}\nspcomment{//creates figure with id==0 and make it the current one}
plot2d()\nspoperator{,}\nspcomment{//draw in current figure (id=0)}
scf(f4)\nspoperator{;}\nspcomment{// set first created figure as current one}
plot3d()\nspoperator{,}\nspcomment{//draw in current figure (id=4)}
\end{Verbatim}
