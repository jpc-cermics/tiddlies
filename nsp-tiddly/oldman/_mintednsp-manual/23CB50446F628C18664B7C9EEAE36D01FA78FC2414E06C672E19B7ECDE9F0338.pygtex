\begin{Verbatim}[commandchars=\\\{\}]
Sheets=readxls(\nspstring{'SCI/demos/excel/t1.xls'})
\nspcomment{// some basic operations on Sheets}
typeof(Sheets)
s1=Sheets(\nspnumber{1})\nspoperator{,}\nspcomment{//get the first sheet}
typeof(s1)
s1.value\nspoperator{,}\nspcomment{//get the first sheet value field}
s1.text\nspoperator{,}\nspcomment{//get the first sheet text field}
s1(\nspnumber{2},\nspoperator{:})\nspoperator{,}\nspcomment{//get the 2 row of the sheet}
typeof(s1(\nspnumber{2},\nspoperator{:}))
editvar(s1)\nspoperator{;}
\end{Verbatim}
