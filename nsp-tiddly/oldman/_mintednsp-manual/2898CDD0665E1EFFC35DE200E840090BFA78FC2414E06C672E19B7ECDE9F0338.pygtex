\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{//inline definition (see function)}
\nspkeyword{function} [x,y]=\nspfunction{myfct}(a,b)
  x=a\nspoperator{+}b
  y=a\nspoperator{-}b
\nspkeyword{endfunction}
[x,y]=myfct(\nspnumber{3},\nspnumber{2})
\nspcomment{//inline definition (see deff)}
deff(\nspstring{'[x,y]=myfct(a,b)'},[\nspstring{'x=a+b'}\nspoperator{;}\nspstring{'y=a-b'}])
\nspcomment{// definition in an ascii file (see exec)}
\nspkeyword{exec} SCI/macros/elem/asinh.sci\nspoperator{;}
\nspcomment{// definition in an ascii file (see getf)}
\nspcomment{// getf SCI/macros/elem/asinh.sci;}
\end{Verbatim}
