\begin{Verbatim}[commandchars=\\\{\}]
addmenu(\nspstring{'foo'})\nspoperator{,}\nspcomment{//New button made in main scilab window}
unsetmenu(\nspstring{'foo'})\nspoperator{,}\nspcomment{//button foo cannot be activated (grey string)}
setmenu(\nspstring{'foo'})\nspoperator{,}\nspcomment{//button foo can be activated (black string)}
\end{Verbatim}
