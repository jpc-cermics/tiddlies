\begin{Verbatim}[commandchars=\\\{\}]
a=eye(\nspnumber{2},\nspnumber{2})\nspoperator{;}b=ones(a)\nspoperator{;}
oldsave(TMPDIR\nspoperator{+}\nspstring{'/vals.dat'},a,b)\nspoperator{;}
\nspkeyword{clear} a
\nspkeyword{clear} b
oldload(TMPDIR\nspoperator{+}\nspstring{'/vals.dat'},\nspstring{'a'},\nspstring{'b'})\nspoperator{;}
\end{Verbatim}
