\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{//Chebyshev; ripple in the passband}
n=\nspnumber{13}\nspoperator{;}epsilon=\nspnumber{0.2}\nspoperator{;}omegac=\nspnumber{3}\nspoperator{;}sample=\nspnumber{0}\nspoperator{:}\nspnumber{0.05}\nspoperator{:}\nspnumber{10}\nspoperator{;}
h=cheb1mag(n,omegac,epsilon,sample)\nspoperator{;}
plot(sample,h,\nspstring{'frequencies'},\nspstring{'magnitude'})
\end{Verbatim}
