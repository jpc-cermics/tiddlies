\begin{Verbatim}[commandchars=\\\{\}]
A=[\nspstring{'1'}\nspoperator{,}\nspstring{'a'}\nspoperator{;}\nspstring{'0'}\nspoperator{,}\nspstring{'2'}]\nspoperator{;}\nspcomment{//Upper triangular}
b=[\nspstring{'x'}\nspoperator{;}\nspstring{'y'}]\nspoperator{;}
w=solve(A,b)
a=\nspnumber{1}\nspoperator{;}x=\nspnumber{2}\nspoperator{;}y=\nspnumber{5}\nspoperator{;}
evstr(w)
inv([\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{;}\nspnumber{0}\nspoperator{,}\nspnumber{2}])\nspoperator{*}[\nspnumber{2}\nspoperator{;}\nspnumber{5}]
\end{Verbatim}
