\begin{Verbatim}[commandchars=\\\{\}]
s=poly(\nspnumber{0},\nspstring{'s'})\nspoperator{;}
[n,d]=simp((s\nspoperator{+}\nspnumber{1})\nspoperator{*}(s\nspoperator{+}\nspnumber{2}),(s\nspoperator{+}\nspnumber{1})\nspoperator{*}(s\nspoperator{-}\nspnumber{2}))
simp_mode(%F)\nspoperator{;}hns=s\nspoperator{/}s
simp_mode(%T)\nspoperator{;}hns=s\nspoperator{/}s
