\begin{Verbatim}[commandchars=\\\{\}]
set(\nspstring{"figure_style"},\nspstring{"new"})
\nspcomment{//create a figure}
t=[\nspnumber{0}\nspoperator{:}\nspnumber{0.3}\nspoperator{:}\nspnumber{2}\nspoperator{*}%pi]\nspoperator{'}\nspoperator{;}z=sin(t)\nspoperator{*}cos(t\nspoperator{'})\nspoperator{;}
[xx,yy,zz]=genfac3d(t,t,z)\nspoperator{;}
plot3d([xx\nspoperator{,}xx],[yy\nspoperator{,}yy],list([zz\nspoperator{,}zz\nspoperator{+}\nspnumber{4}],[\nspnumber{4}\nspoperator{*}ones(\nspnumber{1},\nspnumber{400})\nspoperator{,}\nspnumber{5}\nspoperator{*}ones(\nspnumber{1},\nspnumber{400})]))
h=get(\nspstring{"hdl"})\nspoperator{,}\nspcomment{//get handle on current entity (here the surface)}
a=gca()\nspoperator{;}\nspcomment{//get current axes}
a.rotation_angles=[\nspnumber{40}\nspoperator{,}\nspnumber{70}]\nspoperator{;}
a.grid=[\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{1}]\nspoperator{;}
\nspcomment{//make grids}
a.data_bounds=[\nspoperator{-}\nspnumber{6}\nspoperator{,}\nspnumber{6}\nspoperator{;}\nspnumber{6}\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{;}\nspnumber{0}\nspoperator{,}\nspnumber{5}]\nspoperator{;}
a.axes_visible=\nspstring{"off"}\nspoperator{;}
\nspcomment{//axes are hidden a.axes_bounds=[.2 0 1 1];}
f=get(\nspstring{"current_figure"})\nspoperator{;}
\nspcomment{//get the handle of the parent figure}
f.color_map=hotcolormap(\nspnumber{64})\nspoperator{;}
\nspcomment{//change the figure colormap}
h.color_flag=\nspnumber{1}\nspoperator{;}
\nspcomment{//color according to z}
h.color_mode=\nspoperator{-}\nspnumber{2}\nspoperator{;}
\nspcomment{//remove the facets boundary}
h.color_flag=\nspnumber{2}\nspoperator{;}
\nspcomment{//color according to given colors}
h.data.color=[\nspnumber{1}\nspoperator{+}modulo(\nspnumber{1}\nspoperator{:}\nspnumber{400},\nspnumber{64})\nspoperator{,}\nspnumber{1}\nspoperator{+}modulo(\nspnumber{1}\nspoperator{:}\nspnumber{400},\nspnumber{64})]\nspoperator{;}
\nspcomment{//shaded}
h.color_flag=\nspnumber{3}\nspoperator{;}
scf(\nspnumber{2})\nspoperator{;}\nspcomment{// creates second window and use surf command}
subplot(\nspnumber{211})
surf(z,\nspstring{'cdata_mapping'},\nspstring{'direct'},\nspstring{'facecol'},\nspstring{'interp'})
subplot(\nspnumber{212})
surf(t,t,z,\nspstring{'edgeco'},\nspstring{'b'},\nspstring{'marker'},\nspstring{'d'},\nspstring{'markersiz'},\nspnumber{9},\nspstring{'markeredg'},\nspstring{'red'},\nspstring{'markerfac'},\nspstring{'k'})
e=gce()\nspoperator{;}
e.color_flag=\nspnumber{1}\nspoperator{,}\nspcomment{// color index proportional to altitude (z coord.)}
e.color_flag=\nspnumber{2}\nspoperator{;}\nspcomment{// back to default mode}
e.color_flag=\nspnumber{3}\nspoperator{;}
\nspcomment{// interpolated shading mode (based on blue default color because field data.color is not filled)}
\end{Verbatim}
