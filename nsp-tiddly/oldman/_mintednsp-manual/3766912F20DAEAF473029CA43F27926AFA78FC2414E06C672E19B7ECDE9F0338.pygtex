\begin{Verbatim}[commandchars=\\\{\}]
A=[\nspoperator{-}eye(\nspnumber{2},\nspnumber{2})\nspoperator{,}rand(\nspnumber{2},\nspnumber{2})\nspoperator{;}zeros(\nspnumber{2},\nspnumber{2})\nspoperator{,}\nspoperator{-}\nspnumber{2}\nspoperator{*}eye(\nspnumber{2},\nspnumber{2})]\nspoperator{;}
B=[rand(\nspnumber{2},\nspnumber{2})\nspoperator{;}zeros(\nspnumber{2},\nspnumber{2})]\nspoperator{;}C=rand(\nspnumber{2},\nspnumber{4})\nspoperator{;}
sl=syslin(\nspstring{'c'},A,B,C)\nspoperator{;}
