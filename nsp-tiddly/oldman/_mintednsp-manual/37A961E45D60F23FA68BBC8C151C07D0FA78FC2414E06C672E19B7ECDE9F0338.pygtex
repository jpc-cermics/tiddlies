\begin{Verbatim}[commandchars=\\\{\}]
txt=[\nspstring{'The night has a thousand stars'}\nspoperator{;}\nspstring{'night train'}\nspoperator{;}\nspstring{'a star is born'}\nspoperator{;}\nspstring{'naima'}]\nspoperator{;}
\nspcomment{// grep(txt,'star');}
e1=find(strstr(txt,\nspstring{'star'}))
\nspcomment{// grep(txt,['star' 'night'])}
e2=find(strstr(txt,\nspstring{'night'}))\nspoperator{;}
e3=union(e1,e2)\nspoperator{;}
\end{Verbatim}
