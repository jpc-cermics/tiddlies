\begin{Verbatim}[commandchars=\\\{\}]
x=\nspnumber{0}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{10}\nspoperator{;}
set(\nspstring{"figure_style"},\nspstring{"new"})
[mark,mrkSize]=getmark()\nspoperator{;}
plot2d(x,sin(x),style = \nspoperator{-}mark)\nspoperator{;}
clf()\nspoperator{;}
plot2d(x,sin(x))
e=gce()\nspoperator{;}\nspcomment{// store the agregation containing the plot}
[mark,mrkSize]=getmark()\nspoperator{;}
e.children(\nspnumber{1}).mark_style=mark\nspoperator{;}
\end{Verbatim}
