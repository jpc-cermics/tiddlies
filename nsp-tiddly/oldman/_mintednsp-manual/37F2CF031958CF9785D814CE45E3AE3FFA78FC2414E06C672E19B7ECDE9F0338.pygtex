\nspcomment{//using the new primitive}
a=[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{3}]\nspoperator{;}b=[\nspnumber{4}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{6}]\nspoperator{;}n=\nspnumber{3}\nspoperator{;}
