\begin{Verbatim}[commandchars=\\\{\}]
f1=[\nspstring{'int ext1c(n, a, b, c)'}\nspoperator{;}\nspstring{'int *n;     double *a, *b, *c;'}\nspoperator{;}\nspstring{'\nspob{}int k;'}\nspoperator{;}
    \nspstring{'  for (k = 0; k $&lt;$ *n; ++k) '}\nspoperator{;}\nspstring{'      c[k] = a[k] + b[k];'}\nspoperator{;}\nspstring{'  return(0);\nspcb{}'}]\nspoperator{;}
mputl(f1,\nspstring{'fun1.c'})
\nspcomment{//creating the shared library (a gateway, a Makefile and a loader are}
