\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// set old_style off}
f=gdf()\nspoperator{,}\nspcomment{// get the handle of the model figure}
\nspcomment{// setting its' properties}
f.background=\nspnumber{7}\nspoperator{;}
f.figure_name=\nspstring{"Function gdf()"}\nspoperator{;}
f.figure_position=[\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspnumber{100}]\nspoperator{;}
f.auto_resize=\nspstring{"off"}\nspoperator{;}
f.figure_size=[\nspnumber{300}\nspoperator{,}\nspnumber{461}]\nspoperator{;}
f.axes_size=[\nspnumber{600}\nspoperator{,}\nspnumber{400}]\nspoperator{;}
plot2d()\nspoperator{,}\nspcomment{//create a figure}
scf(\nspnumber{1})\nspoperator{;}
plot3d()\nspoperator{,}\nspcomment{//create a second figure}
set(f,\nspstring{"default_values"},\nspnumber{1})\nspoperator{;}\nspcomment{// return to the  default values of figure's model}
\nspcomment{// see sdf() function}
scf(\nspnumber{2})\nspoperator{;}
plot2d()
\end{Verbatim}
