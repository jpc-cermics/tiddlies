\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// simple examples}
gamma(\nspnumber{0.5})
gamma(\nspnumber{6})\nspoperator{-}prod(\nspnumber{1}\nspoperator{:}\nspnumber{5})
\nspcomment{// the graph of the Gamma function on [a,b]}
a=\nspoperator{-}\nspnumber{3}\nspoperator{;}b=\nspnumber{5}\nspoperator{;}
x=linspace(a,b,\nspnumber{40000})\nspoperator{'}\nspoperator{;}
y=gamma(x)\nspoperator{;}
xbasc()
c=xget(\nspstring{"color"})
xset(\nspstring{"color"},\nspnumber{2})
plot2d(x,y,style = \nspnumber{0},axesflag = \nspnumber{5},rect = [a\nspoperator{,}\nspoperator{-}\nspnumber{10}\nspoperator{,}b\nspoperator{,}\nspnumber{10}])
xset(\nspstring{"color"},c)
xtitle(\nspstring{"The gamma function on ["}\nspoperator{+}string(a)\nspoperator{+}\nspstring{","}\nspoperator{+}string(b)\nspoperator{+}\nspstring{"]"})
xselect()
\end{Verbatim}
