\begin{Verbatim}[commandchars=\\\{\}]
X1=rand(\nspnumber{5},\nspnumber{2})\nspoperator{;}X2=rand(\nspnumber{5},\nspnumber{3})\nspoperator{;}
P=proj(X1,X2)\nspoperator{;}
norm(P\nspoperator{^}\nspnumber{2}\nspoperator{-}P,\nspnumber{1})
trace(P)\nspoperator{,}\nspcomment{// This is dim(X2)}
[Q,M]=fullrf(P)\nspoperator{;}
svd([Q\nspoperator{,}X2])\nspoperator{,}\nspcomment{// span(Q) = span(X2)}
\end{Verbatim}
