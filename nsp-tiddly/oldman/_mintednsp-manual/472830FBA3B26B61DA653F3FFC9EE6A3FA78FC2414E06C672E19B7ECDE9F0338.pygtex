\begin{Verbatim}[commandchars=\\\{\}]
t=%pi\nspoperator{*}[\nspoperator{-}\nspnumber{10}\nspoperator{:}\nspnumber{10}]\nspoperator{/}\nspnumber{10}\nspoperator{;}
deff(\nspstring{"[z]=surf(x,y)"},\nspstring{"z=sin(x)*cos(y)"})\nspoperator{;}z=feval(t,t,surf)\nspoperator{;}
rect=[\nspoperator{-}%pi\nspoperator{,}%pi\nspoperator{,}\nspoperator{-}%pi\nspoperator{,}%pi\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspnumber{1}]\nspoperator{;}
