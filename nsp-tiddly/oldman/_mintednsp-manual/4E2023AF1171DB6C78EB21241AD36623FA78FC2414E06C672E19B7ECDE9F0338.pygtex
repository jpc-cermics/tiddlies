\begin{Verbatim}[commandchars=\\\{\}]
A=int(\nspnumber{10}\nspoperator{*}rand(\nspnumber{2},\nspnumber{6}))
\nspcomment{// Building a degree 1 polynomial matrix}
P=inv_coeff(A,\nspnumber{1})
norm(coeff(P)\nspoperator{-}A)
\nspcomment{// Using default value for degree}
P1=inv_coeff(A)
norm(coeff(P1)\nspoperator{-}A)
\end{Verbatim}
