\begin{Verbatim}[commandchars=\\\{\}]
\nspkeyword{if} MSDOS \nspkeyword{then}
  unix(\nspstring{'del foo'})\nspoperator{;}
\nspkeyword{else}
  unix(\nspstring{'rm -f foo'})\nspoperator{;}\nspkeyword{end}
A=rand(\nspnumber{3},\nspnumber{5})\nspoperator{;}write(\nspstring{'foo'},A)\nspoperator{;}
B=read(\nspstring{'foo'},\nspnumber{3},\nspnumber{5})
B=read(\nspstring{'foo'},\nspoperator{-}\nspnumber{1},\nspnumber{5})
read(%io(\nspnumber{1}),\nspnumber{1},\nspnumber{1},\nspstring{'(a)'})\nspoperator{,}\nspcomment{// waits for user's input}
\end{Verbatim}
