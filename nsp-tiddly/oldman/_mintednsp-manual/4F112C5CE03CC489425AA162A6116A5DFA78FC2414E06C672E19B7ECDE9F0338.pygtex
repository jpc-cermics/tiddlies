\begin{Verbatim}[commandchars=\\\{\}]
p1=linspace(\nspnumber{0},\nspnumber{2}\nspoperator{*}%pi,\nspnumber{10})\nspoperator{;}
p2=linspace(\nspnumber{0},\nspnumber{2}\nspoperator{*}%pi,\nspnumber{10})\nspoperator{;}
deff(\nspstring{"[x,y,z]=scp(p1,p2)"}, ...
     [\nspstring{"x=p1.*sin(p1).*cos(p2)"}\nspoperator{;}\nspstring{"y=p1.*cos(p1).*cos(p2)"}\nspoperator{;}\nspstring{"z=p1.*sin(p2)"}])
[Xf,Yf,Zf]=eval3dp(scp,p1,p2)\nspoperator{;}
plot3d(Xf,Yf,Zf)
\end{Verbatim}
