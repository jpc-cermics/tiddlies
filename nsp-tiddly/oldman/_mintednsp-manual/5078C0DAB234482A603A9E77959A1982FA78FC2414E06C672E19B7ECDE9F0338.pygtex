\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// Example 1 // one axes / one figure}
set(\nspstring{"figure_style"},\nspstring{"new"})\nspoperator{,}\nspcomment{// select entity based graphics}
drawlater()\nspoperator{;}
xfarc(\nspnumber{.25},\nspnumber{.55},\nspnumber{.1},\nspnumber{.15},\nspnumber{0},\nspnumber{64}\nspoperator{*}\nspnumber{360})\nspoperator{;}
xfarc(\nspnumber{.55},\nspnumber{.55},\nspnumber{.1},\nspnumber{.15},\nspnumber{0},\nspnumber{64}\nspoperator{*}\nspnumber{360})\nspoperator{;}
xfrect(\nspnumber{.3},\nspnumber{.8},\nspnumber{.3},\nspnumber{.2})\nspoperator{;}
xfrect(\nspnumber{.2},\nspnumber{.7},\nspnumber{.5},\nspnumber{.2})\nspoperator{;}
xfrect(\nspnumber{.32},\nspnumber{.78},\nspnumber{.1},\nspnumber{.1})\nspoperator{;}
xfrect(\nspnumber{.44},\nspnumber{.78},\nspnumber{.14},\nspnumber{.1})\nspoperator{;}
xfrect(\nspoperator{-}\nspnumber{.2},\nspnumber{.4},\nspnumber{1.5},\nspnumber{.8})\nspoperator{;}
xstring(\nspnumber{0.33},\nspnumber{.9},\nspstring{"A Scilab Car"})\nspoperator{;}
a=get(\nspstring{"current_axes"})\nspoperator{;}
a.children(\nspnumber{1}).font_size=\nspnumber{4}\nspoperator{;}
a.children(\nspnumber{1}).font_style=\nspnumber{4}\nspoperator{;}
a.children(\nspnumber{1}).foreground=\nspnumber{5}\nspoperator{;}
a.children(\nspnumber{3}).foreground=\nspnumber{8}\nspoperator{;}
a.children(\nspnumber{4}).foreground=\nspnumber{8}\nspoperator{;}
a.children(\nspnumber{5}).foreground=\nspnumber{17}\nspoperator{;}
a.children(\nspnumber{6}).foreground=\nspnumber{17}\nspoperator{;}
a.children(\nspnumber{7}).foreground=\nspnumber{25}\nspoperator{;}
a.children(\nspnumber{8}).foreground=\nspnumber{25}\nspoperator{;}
xclick()\nspoperator{;}drawnow()\nspoperator{;}
\nspcomment{// Example 2 // two axes / one figure}
subplot(\nspnumber{212})
a=gca()\nspoperator{;}
drawlater\nspoperator{,}\nspcomment{// what will be present in this axes will be displayed later}
plot2d\nspoperator{,}\nspcomment{// draw these axes and children later...}
subplot(\nspnumber{211})\nspoperator{,}\nspcomment{// Warning: we change the axes}
plot2d1()\nspoperator{,}\nspcomment{// default drawing mode}
draw(a)\nspoperator{,}\nspcomment{// ...axes only is visible providing you not redraw the window}
drawnow()\nspoperator{,}\nspcomment{// all is visible}
\end{Verbatim}
