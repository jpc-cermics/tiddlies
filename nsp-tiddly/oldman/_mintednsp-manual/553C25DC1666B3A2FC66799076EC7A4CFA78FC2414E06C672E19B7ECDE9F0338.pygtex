\begin{Verbatim}[commandchars=\\\{\}]
\nspkeyword{while} %t \nspkeyword{do}
  n=round(\nspnumber{10}\nspoperator{*}rand(\nspnumber{1},\nspnumber{1}))
  \nspkeyword{select} n
    \nspkeyword{case} \nspnumber{0} \nspkeyword{then}
     disp(\nspnumber{0})
    \nspkeyword{case} \nspnumber{1} \nspkeyword{then}
     disp(\nspnumber{1})
    \nspkeyword{else}
      \nspkeyword{break}
  \nspkeyword{end}
\nspkeyword{end}
\end{Verbatim}
