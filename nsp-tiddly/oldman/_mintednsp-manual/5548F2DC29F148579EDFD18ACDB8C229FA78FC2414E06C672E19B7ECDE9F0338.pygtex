\begin{Verbatim}[commandchars=\\\{\}]
wavread(\nspstring{'SCI/demos/signal/sound/chimes.wav'},\nspstring{'size'})
[y,Fs,bits]=wavread(\nspstring{'SCI/demos/signal/sound/chimes.wav'})\nspoperator{;}Fs\nspoperator{,}bits
subplot(\nspnumber{2},\nspnumber{1},\nspnumber{1})
plot2d(y(\nspoperator{:},\nspnumber{1}))
subplot(\nspnumber{2},\nspnumber{1},\nspnumber{2})
plot2d(y(\nspoperator{:},\nspnumber{2}))
y=wavread(\nspstring{'SCI/demos/signal/sound/chimes.wav'},[\nspnumber{1}\nspoperator{,}\nspnumber{5}])\nspoperator{,}\nspcomment{//the first five samples}
\end{Verbatim}
