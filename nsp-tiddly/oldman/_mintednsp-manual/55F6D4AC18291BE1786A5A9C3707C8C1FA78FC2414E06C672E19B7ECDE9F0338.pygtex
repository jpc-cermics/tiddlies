\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// multiple plot without giving x}
x=[\nspnumber{0}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{2}\nspoperator{*}%pi]\nspoperator{'}\nspoperator{;}
plot2d1(\nspstring{"enn"},\nspnumber{1},[sin(x)\nspoperator{,}sin(\nspnumber{2}\nspoperator{*}x)\nspoperator{,}sin(\nspnumber{3}\nspoperator{*}x)])
\nspcomment{// multiple plot using only one x}
clf()
plot2d1(\nspstring{"onn"},x,[sin(x)\nspoperator{,}sin(\nspnumber{2}\nspoperator{*}x)\nspoperator{,}sin(\nspnumber{3}\nspoperator{*}x)])
\nspcomment{// logarithmic plot}
x=[\nspnumber{0.1}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{3}]\nspoperator{'}\nspoperator{;}clf()
plot2d1(\nspstring{"oll"},x,[exp(x)\nspoperator{,}exp(x\nspoperator{^}\nspnumber{2})\nspoperator{,}exp(x\nspoperator{^}\nspnumber{3})])
\end{Verbatim}
