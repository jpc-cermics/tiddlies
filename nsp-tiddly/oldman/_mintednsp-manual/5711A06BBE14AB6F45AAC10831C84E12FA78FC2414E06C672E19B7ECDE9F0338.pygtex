\begin{Verbatim}[commandchars=\\\{\}]
a=gda()\nspoperator{,}\nspcomment{// get the handle of the model axes}
\nspcomment{// setting its' properties}
a.background=\nspnumber{31}\nspoperator{;}
a.box=\nspstring{"off"}\nspoperator{;}
a.rotation_angles=[\nspnumber{70}\nspoperator{,}\nspnumber{10}]\nspoperator{;}
a.tics_color=\nspnumber{2}\nspoperator{;}
a.labels_font_size=\nspnumber{3}\nspoperator{;}
a.labels_font_color=\nspnumber{5}\nspoperator{;}
a.sub_tics=[\nspnumber{5}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{3}]\nspoperator{;}
a.x_location=\nspstring{"top"}\nspoperator{;}
set(\nspstring{"figure_style"},\nspstring{"new"})
subplot(\nspnumber{211})
plot2d()\nspoperator{,}\nspcomment{//create an axes entity}
subplot(\nspnumber{212})
plot3d1()\nspoperator{,}\nspcomment{//create a second axes entity}
a.grids=[\nspnumber{5}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{5}]\nspoperator{;}\nspcomment{// setting other model's properties}
clf()
t=\nspnumber{0}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{5}\nspoperator{*}%pi\nspoperator{;}
plot2d(sin(t),cos(t),t\nspoperator{/}\nspnumber{10})
set(a,\nspstring{"default_values"},\nspnumber{1})\nspoperator{;}\nspcomment{// return to the  default values of the model}
\nspcomment{// see sda() function}
clf()
plot2d(sin(t),cos(t),t\nspoperator{/}\nspnumber{10})
\end{Verbatim}
