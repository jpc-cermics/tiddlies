\begin{Verbatim}[commandchars=\\\{\}]
x=linspace(\nspoperator{-}\nspnumber{2}\nspoperator{*}%pi,\nspnumber{2}\nspoperator{*}%pi,\nspnumber{100})\nspoperator{'}\nspoperator{;}
\nspcomment{// using existing colors}
plot2d(x,[sin(x)\nspoperator{,}cos(x)],style = [color(\nspstring{"red"})\nspoperator{,}color(\nspstring{"green"})])\nspoperator{;}
\nspcomment{// new colors: there are added to the colormap}
e=gce()\nspoperator{;}p1=e.children(\nspnumber{1})\nspoperator{;}p2=e.children(\nspnumber{2})\nspoperator{;}
p1.foreground=color(\nspstring{"purple"})\nspoperator{;}p2.foreground=color(\nspstring{"navy blue"})\nspoperator{;}
\nspcomment{// using RGV values}
p1.foreground=color(\nspnumber{255},\nspnumber{128},\nspnumber{128})\nspoperator{;}
\end{Verbatim}
