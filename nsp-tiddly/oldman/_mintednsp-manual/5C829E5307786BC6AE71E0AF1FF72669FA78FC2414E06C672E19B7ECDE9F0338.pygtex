\begin{Verbatim}[commandchars=\\\{\}]
winId=progressionbar(\nspstring{'Do something'})\nspoperator{;}
realtimeinit(\nspnumber{0.3})\nspoperator{;}
\nspkeyword{for} j=\nspnumber{0}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{1} \nspkeyword{do}
  realtime(\nspnumber{3}\nspoperator{*}j)\nspoperator{;}
  progressionbar(winId)\nspoperator{;}
\nspkeyword{end}
winclose(winId)\nspoperator{;}
\end{Verbatim}
