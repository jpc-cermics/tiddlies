\begin{Verbatim}[commandchars=\\\{\}]
deff(\nspstring{'exampl(a,varargin)'},[\nspstring{'[lhs,rhs]=argn(0)'}\nspoperator{;}\nspstring{'if rhs$&gt;$=1 then disp(varargin),end'}])
