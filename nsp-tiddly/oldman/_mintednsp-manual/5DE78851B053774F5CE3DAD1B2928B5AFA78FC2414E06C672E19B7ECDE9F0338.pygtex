\begin{Verbatim}[commandchars=\\\{\}]
funcprot(\nspnumber{1})
deff(\nspstring{'[x]=foo(a)'},\nspstring{'x=a'})
deff(\nspstring{'[x]=foo(a)'},\nspstring{'x=a+1'})
foo=\nspnumber{33}
funcprot(\nspnumber{0})
deff(\nspstring{'[x]=foo(a)'},\nspstring{'x=a'})
deff(\nspstring{'[x]=foo(a)'},\nspstring{'x=a+1'})
foo=\nspnumber{33}
\end{Verbatim}
