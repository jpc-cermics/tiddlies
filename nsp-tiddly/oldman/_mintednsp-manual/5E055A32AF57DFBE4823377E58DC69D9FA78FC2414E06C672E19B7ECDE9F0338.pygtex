\begin{Verbatim}[commandchars=\\\{\}]
[s,p]=sort(rand(\nspnumber{1},\nspnumber{10}))\nspoperator{;}
\nspcomment{//p  is a random permutation of 1:10}
A=[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{5}\nspoperator{;}\nspnumber{3}\nspoperator{,}\nspnumber{4}\nspoperator{,}\nspnumber{2}]\nspoperator{;}
[Asorted,q]=sort(A)\nspoperator{;}A(q(\nspoperator{:}))\nspoperator{-}Asorted(\nspoperator{:})
v=\nspnumber{1}\nspoperator{:}\nspnumber{10}\nspoperator{;}
sort(v)
sort(v\nspoperator{'})
sort(v,\nspstring{'r'})\nspoperator{,}\nspcomment{//Does nothing for row vectors}
sort(v,\nspstring{'c'})
\end{Verbatim}
