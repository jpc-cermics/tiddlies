\begin{Verbatim}[commandchars=\\\{\}]
set(\nspstring{"figure_style"},\nspstring{"new"})\nspoperator{,}\nspcomment{//create a figure}
a=get(\nspstring{"current_axes"})\nspoperator{;}\nspcomment{//get the handle of the newly created axes}
t=[\nspnumber{0}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{5}\nspoperator{*}%pi]\nspoperator{'}\nspoperator{;}
param3d1([sin(t)\nspoperator{,}sin(\nspnumber{2}\nspoperator{*}t)],[cos(t)\nspoperator{,}cos(\nspnumber{2}\nspoperator{*}t)],[t\nspoperator{/}\nspnumber{10}\nspoperator{,}sin(t)])
a.rotation_angles=[\nspnumber{65}\nspoperator{,}\nspnumber{75}]\nspoperator{;}
a.data_bounds=[\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{;}\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{2}]\nspoperator{;}\nspcomment{//boundaries given by data_bounds}
a.thickness=\nspnumber{2}\nspoperator{;}
h=a.children\nspoperator{,}\nspcomment{//get the handle of the param3d entity: an agregation composed of 2 curves}
h.children(\nspnumber{1}).foreground=\nspnumber{3}\nspoperator{,}\nspcomment{// first curve}
curve2=h.children(\nspnumber{2})\nspoperator{;}
curve2.foreground=\nspnumber{6}\nspoperator{;}
curve2.mark_style=\nspnumber{2}\nspoperator{;}
\end{Verbatim}
