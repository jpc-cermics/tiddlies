\begin{Verbatim}[commandchars=\\\{\}]
ny=\nspnumber{2}\nspoperator{;}nu=\nspnumber{3}\nspoperator{;}nx=\nspnumber{4}\nspoperator{;}
P22=ssrand(ny,nu,nx)\nspoperator{;}
bigQ=rand(nx\nspoperator{+}nu,nx\nspoperator{+}nu)\nspoperator{;}bigQ=bigQ\nspoperator{*}bigQ\nspoperator{'}\nspoperator{;}
bigR=rand(nx\nspoperator{+}ny,nx\nspoperator{+}ny)\nspoperator{;}bigR=bigR\nspoperator{*}bigR\nspoperator{'}\nspoperator{;}
[P,r]=lqg2stan(P22,bigQ,bigR)\nspoperator{;}K=lqg(P,r)\nspoperator{;}\nspcomment{//K=LQG-controller}
spec(h_cl(P,r,K))\nspoperator{,}\nspcomment{//Closed loop should be stable}
\nspcomment{//Same as Cl=P22/.K; spec(Cl('A'))}
s=poly(\nspnumber{0},\nspstring{'s'})
lqg2stan(\nspnumber{1}\nspoperator{/}(s\nspoperator{+}\nspnumber{2}),eye(\nspnumber{2},\nspnumber{2}),eye(\nspnumber{2},\nspnumber{2}))
\end{Verbatim}
