\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// examples with the second form}
x=[\nspnumber{1}\nspoperator{,}%i\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{,}%i]
phasex=atan(imag(x),real(x))
atan(\nspnumber{0},\nspoperator{-}\nspnumber{1})
atan(\nspoperator{-}%eps,\nspoperator{-}\nspnumber{1})
\nspcomment{// branch cuts}
atan(\nspoperator{-}%eps\nspoperator{+}\nspnumber{2}\nspoperator{*}%i)
atan(%eps\nspoperator{+}\nspnumber{2}\nspoperator{*}%i)
atan(\nspoperator{-}%eps\nspoperator{-}\nspnumber{2}\nspoperator{*}%i)
atan(%eps\nspoperator{-}\nspnumber{2}\nspoperator{*}%i)
\nspcomment{// values at the branching points}
ieee(\nspnumber{2})
atan(%i)
atan(\nspoperator{-}%i)
\end{Verbatim}
