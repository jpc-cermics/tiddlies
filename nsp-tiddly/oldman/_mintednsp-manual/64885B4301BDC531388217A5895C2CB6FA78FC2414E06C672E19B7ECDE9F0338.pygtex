\begin{Verbatim}[commandchars=\\\{\}]
TK_EvalStr(\nspstring{'toplevel .tst2'})\nspoperator{;}
\nspcomment{// creates a toplevel TK window.}
TK_EvalStr(\nspstring{'label .tst2.l -textvariable tvar'})\nspoperator{;}
\nspcomment{// create a static label}
TK_EvalStr(\nspstring{'pack .tst2.l'})\nspoperator{;}
\nspcomment{// pack the label widget. It appears on the screen.}
TK_SetVar(\nspstring{'tvar'},\nspstring{'This text has been set directly within scilab'})\nspoperator{;}
\nspcomment{//destroy toplevel  TK window.}
TK_EvalStr(\nspstring{'destroy .tst2'})
\end{Verbatim}
