\begin{Verbatim}[commandchars=\\\{\}]
x=linspace(\nspnumber{0},\nspnumber{3},\nspnumber{20})\nspoperator{;}
y=x\nspoperator{^}\nspnumber{2}\nspoperator{;}
xx=linspace(\nspnumber{0},\nspnumber{3},\nspnumber{100})\nspoperator{;}
yy1=interp1(x,y,xx,\nspstring{'linear'})\nspoperator{;}
yy2=interp1(x,y,xx,\nspstring{'spline'})\nspoperator{;}
yy3=interp1(x,y,xx,\nspstring{'nearest'})\nspoperator{;}
plot(xx,[yy1\nspoperator{;}yy2\nspoperator{;}yy3],x,y,\nspstring{'*'})
xtitle(\nspstring{'interpolation of square function'})
legend([\nspstring{'linear'}\nspoperator{,}\nspstring{'spline'}\nspoperator{,}\nspstring{'nearest'}],a = \nspnumber{2})
\end{Verbatim}
