\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// QR factorization, generic case}
\nspcomment{// X is tall (full rank)}
X=rand(\nspnumber{5},\nspnumber{2})\nspoperator{;}[Q,R]=qr(X)\nspoperator{;}[Q\nspoperator{'}\nspoperator{*}X\nspoperator{,}R]
\nspcomment{//X is fat (full rank)}
X=rand(\nspnumber{2},\nspnumber{3})\nspoperator{;}[Q,R]=qr(X)\nspoperator{;}[Q\nspoperator{'}\nspoperator{*}X\nspoperator{,}R]
\nspcomment{//Column 4 of X is a linear combination of columns 1 and 2:}
X=rand(\nspnumber{8},\nspnumber{5})\nspoperator{;}X(\nspoperator{:},\nspnumber{4})=X(\nspoperator{:},\nspnumber{1})\nspoperator{+}X(\nspoperator{:},\nspnumber{2})\nspoperator{;}[Q,R]=qr(X)\nspoperator{;}R\nspoperator{,}R(\nspoperator{:},\nspnumber{4})
\nspcomment{//X has rank 2, rows 3 to $ of R are zero:}
X=rand(\nspnumber{8},\nspnumber{2})\nspoperator{*}rand(\nspnumber{2},\nspnumber{5})\nspoperator{;}[Q,R]=qr(X)\nspoperator{;}R
\nspcomment{//Evaluating the rank rk: column pivoting ==$>$ rk first}
\nspcomment{//diagonal entries of R are non zero:}
A=rand(\nspnumber{5},\nspnumber{2})\nspoperator{*}rand(\nspnumber{2},\nspnumber{5})\nspoperator{;}
[Q,R,rk,E]=qr(A,\nspnumber{1.E-10})\nspoperator{;}
norm(Q\nspoperator{'}\nspoperator{*}A\nspoperator{-}R)
svd([A\nspoperator{,}Q(\nspoperator{:},\nspnumber{1}\nspoperator{:}rk)])\nspoperator{,}\nspcomment{//span(A) =span(Q(:,1:rk))}
\end{Verbatim}
