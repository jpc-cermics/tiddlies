\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// Suppose you want to load some codes via the dynamic}
\nspcomment{// loading facilities offers by addinter. By default}
\nspcomment{// arguments are passed by values but if you want to}
\nspcomment{// pass them by reference you can do the following}
\nspcomment{// (name being the scilab name of one of the interfaced}
\nspcomment{// routines):}
\nspcomment{//}
\nspcomment{// addinter(files,spnames,fcts)  // args passed by values}
\nspcomment{// num_interface = floor(funptr(name)/100)}
\nspcomment{// intppty(num_interface)  // args now passed by reference}
\nspcomment{//}
\nspcomment{// Note that if you enter the following}
\nspcomment{//}
\nspcomment{// intppty()}
\nspcomment{//}
\nspcomment{// you will see all the interfaces working by reference}
\end{Verbatim}
