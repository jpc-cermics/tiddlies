\begin{Verbatim}[commandchars=\\\{\}]
set(\nspstring{"figure_style"},\nspstring{"new"})\nspoperator{,}\nspcomment{//create a figure}
a=get(\nspstring{"current_axes"})\nspoperator{;}
a.title
type(a.title)
plot3d()
a.x_label
a.y_label
a.z_label
xtitle(\nspstring{"My title"},\nspstring{"my x axis label"},\nspstring{"Volume"})
a.z_label.text=\nspstring{"Month"}
t=a.title\nspoperator{;}
t.foreground=\nspnumber{9}\nspoperator{;}
t.font_size=\nspnumber{5}\nspoperator{;}
t.font_style=\nspnumber{5}\nspoperator{;}
t.text=\nspstring{"SCILAB"}\nspoperator{;}
xlabel=a.x_label\nspoperator{;}
xlabel.text=\nspstring{" Weight"}
xlabel.font_style=\nspnumber{5}\nspoperator{;}
a.y_label.foreground=\nspnumber{12}\nspoperator{;}
\end{Verbatim}
