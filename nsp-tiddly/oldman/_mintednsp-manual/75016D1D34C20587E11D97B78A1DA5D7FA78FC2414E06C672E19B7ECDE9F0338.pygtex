\begin{Verbatim}[commandchars=\\\{\}]
A=rand(\nspnumber{6},\nspnumber{2})\nspoperator{*}rand(\nspnumber{2},\nspnumber{5})\nspoperator{;}\nspcomment{// rank(A)=2}
B=[A(\nspoperator{:},\nspnumber{1})\nspoperator{,}rand(\nspnumber{6},\nspnumber{2})]\nspoperator{*}rand(\nspnumber{3},\nspnumber{3})\nspoperator{;}\nspcomment{//two additional independent vectors}
[X,dim,dimA]=spanplus(A,B)\nspoperator{;}
dimA
dim
\end{Verbatim}
