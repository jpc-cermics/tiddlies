\begin{Verbatim}[commandchars=\\\{\}]
u=file(\nspstring{'open'},\nspstring{'results'},\nspstring{'unknown'})\nspoperator{,}\nspcomment{//open the result file}
t=\nspnumber{0}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{2}\nspoperator{*}%pi\nspoperator{;}
\nspkeyword{for} tk=t \nspkeyword{do}
  fprintf(u,\nspstring{'time = \nsppc{}6.3f value = \nsppc{}6.3f'},tk,sin(tk))\nspoperator{;}\nspcomment{// write a line}
\nspkeyword{end}
file(\nspstring{'close'},u)\nspoperator{,}\nspcomment{//close the result file}
\end{Verbatim}
