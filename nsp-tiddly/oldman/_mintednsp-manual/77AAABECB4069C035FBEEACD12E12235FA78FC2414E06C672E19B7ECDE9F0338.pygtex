\begin{Verbatim}[commandchars=\\\{\}]
A=[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{;}\nspnumber{3}\nspoperator{,}\nspnumber{4}]\nspoperator{;}
logm(A)
expm(logm(A))
A1=A\nspoperator{*}A\nspoperator{'}\nspoperator{;}
