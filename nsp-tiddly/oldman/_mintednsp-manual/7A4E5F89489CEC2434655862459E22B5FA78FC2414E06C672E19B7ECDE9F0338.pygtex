\begin{Verbatim}[commandchars=\\\{\}]
x=\nspnumber{1}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{10}\nspoperator{;}\nspcomment{// Init.}
plot(x,sin(x),\nspstring{'r.-$&gt;$'})\nspoperator{,}
\nspcomment{// plots a dash-dotted line with a right-pointing triangle centered on each points.}
clf()\nspoperator{;}
\nspcomment{// If you specify a marker wihtout a line style, only the marker is drawn}
plot(x,sin(x),\nspstring{'d'})\nspoperator{,}
\nspcomment{// plots a dash-dotted line with a right-pointing triangle centered on each points.}
x=\nspnumber{1}\nspoperator{:}\nspnumber{10}\nspoperator{;}\nspcomment{// Init.}
\nspcomment{// combinations' order does not matter}
plot(x,x\nspoperator{ .*}x,\nspstring{'*cya--'})
\nspcomment{//multiple plots with different LineSpecs}
clf()\nspoperator{;}
t=\nspnumber{0}\nspoperator{:}%pi\nspoperator{/}\nspnumber{20}\nspoperator{:}\nspnumber{2}\nspoperator{*}%pi\nspoperator{;}
plot(t,sin(t),\nspstring{'ro-.'},t,cos(t),\nspstring{'cya+'},t,abs(sin(t)),\nspstring{'--mo'})
\end{Verbatim}
