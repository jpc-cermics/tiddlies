\begin{Verbatim}[commandchars=\\\{\}]
x=\nspnumber{0}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{2}\nspoperator{*}%pi\nspoperator{;}
\nspcomment{// simple plot}
oldplot(sin(x))
\nspcomment{// using captions}
xbasc()
oldplot(x,sin(x),\nspstring{"sin"},\nspstring{"time"},\nspstring{"plot of sinus"})
\nspcomment{// plot 2 functions}
xbasc()
oldplot([sin(x)\nspoperator{;}cos(x)])
\end{Verbatim}
