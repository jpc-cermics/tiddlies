\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// create a simple 2d grid}
nx=\nspnumber{40}\nspoperator{;}ny=\nspnumber{40}\nspoperator{;}
x=linspace(\nspoperator{-}\nspnumber{1},\nspnumber{1},nx)\nspoperator{;}
y=linspace(\nspoperator{-}\nspnumber{1},\nspnumber{1},ny)\nspoperator{;}
[X,Y]=ndgrid(x,y)\nspoperator{;}
\nspcomment{// compute a function on the grid and plot it}
\nspcomment{//deff("z=f(x,y)","z=128*x.^2 .*(1-x).^2 .*y.^2 .*(1-y).^2");}
deff(\nspstring{"z=f(x,y)"},\nspstring{"z=x.^2 + y.^3"})
Z=f(X,Y)\nspoperator{;}
xbasc()
plot3d(x,y,Z,flag = [\nspnumber{2}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{4}])\nspoperator{;}xselect()
\nspcomment{// create a simple 3d grid}
nx=\nspnumber{10}\nspoperator{;}ny=\nspnumber{6}\nspoperator{;}nz=\nspnumber{4}\nspoperator{;}
x=linspace(\nspnumber{0},\nspnumber{2},nx)\nspoperator{;}
y=linspace(\nspnumber{0},\nspnumber{1},ny)\nspoperator{;}
z=linspace(\nspnumber{0},\nspnumber{0.5},nz)\nspoperator{;}
[X,Y,Z]=ndgrid(x,y,z)\nspoperator{;}
\nspcomment{// try to display this 3d grid ...}
XF=[]\nspoperator{;}YF=[]\nspoperator{;}ZF=[]\nspoperator{;}
\nspkeyword{for} k=\nspnumber{1}\nspoperator{:}nz \nspkeyword{do}
  [xf,yf,zf]=nf3d(X(\nspoperator{:},\nspoperator{:},k),Y(\nspoperator{:},\nspoperator{:},k),Z(\nspoperator{:},\nspoperator{:},k))\nspoperator{;}
  XF=[XF\nspoperator{,}xf]\nspoperator{;}YF=[YF\nspoperator{,}yf]\nspoperator{;}ZF=[ZF\nspoperator{,}zf]\nspoperator{;}
\nspkeyword{end}
\nspkeyword{for} j=\nspnumber{1}\nspoperator{:}ny \nspkeyword{do}
  [xf,yf,zf]=nf3d(matrix(X(\nspoperator{:},j,\nspoperator{:}),[nx\nspoperator{,}nz]),matrix(Y(\nspoperator{:},j,\nspoperator{:}),[nx\nspoperator{,}nz]), ...
                  matrix(Z(\nspoperator{:},j,\nspoperator{:}),[nx\nspoperator{,}nz]))\nspoperator{;}
  XF=[XF\nspoperator{,}xf]\nspoperator{;}YF=[YF\nspoperator{,}yf]\nspoperator{;}ZF=[ZF\nspoperator{,}zf]\nspoperator{;}
\nspkeyword{end}
xbasc()
plot3d(XF,YF,ZF,flag = [\nspnumber{0}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{3}],leg = \nspstring{"X@Y@Z"})
xtitle(\nspstring{"A 3d grid !"})\nspoperator{;}xselect()
\end{Verbatim}
