\begin{Verbatim}[commandchars=\\\{\}]
x1=tlist(\nspstring{'x'},\nspnumber{1},\nspnumber{2})\nspoperator{;}
x2=tlist(\nspstring{'x'},\nspnumber{2},\nspnumber{3})\nspoperator{;}
deff(\nspstring{'x=\nsppc{}xmx(x1,x2)'},\nspstring{'x=list(''x'',x1(2)*x2(2),x2(3)*x2(3))'})\nspoperator{;}
x1\nspoperator{*}x2
\end{Verbatim}
