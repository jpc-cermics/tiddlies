\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{//Example with a hypermatrix of ascii codes:}
x=hypermat([\nspnumber{4}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{3}],\nspnumber{61}\nspoperator{:}\nspnumber{84})\nspoperator{;}
y=char(x)
size(x)
size(y)
\nspcomment{//Example with more than one argument:}
st1=\nspstring{"zeros"}\nspoperator{;}
st2=[\nspstring{"one"}\nspoperator{,}\nspstring{"two"}]\nspoperator{;}
st3=[\nspstring{"three"}]\nspoperator{;}
y=char(st1,st2,st3)
size(y)
\nspcomment{//all strings rows are completed by 'blanks' to have the same length: 6}
length(y)
\end{Verbatim}
