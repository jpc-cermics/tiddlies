\begin{Verbatim}[commandchars=\\\{\}]
set(\nspstring{"figure_style"},\nspstring{"new"})\nspoperator{,}\nspcomment{// select entity based graphics}
subplot(\nspnumber{211})\nspoperator{;}
t=\nspnumber{1}\nspoperator{:}\nspnumber{10}\nspoperator{;}plot2d(t,t\nspoperator{ .^}\nspnumber{2})\nspoperator{,}
subplot(\nspnumber{223})\nspoperator{;}
plot3d()\nspoperator{;}
subplot(\nspnumber{224})\nspoperator{;}
plot2d()\nspoperator{;}
