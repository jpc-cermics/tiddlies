a=get(\nspstring{"current_axes"})
delete()\nspoperator{;}\nspcomment{//delete the graphics object newly created}
delete(a.children)\nspoperator{;}\nspcomment{//delete all children of the current axes}
delete(a)\nspoperator{;}\nspcomment{//delete the axes}
delete(\nspstring{"all"})\nspoperator{;}\nspcomment{//delete all the graphics objects of the figure}
