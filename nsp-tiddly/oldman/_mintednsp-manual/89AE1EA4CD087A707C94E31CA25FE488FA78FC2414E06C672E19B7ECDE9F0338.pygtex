\begin{Verbatim}[commandchars=\\\{\}]
A=rand(\nspnumber{5},\nspnumber{3})\nspoperator{*}rand(\nspnumber{3},\nspnumber{8})\nspoperator{;}
b=A\nspoperator{*}ones(\nspnumber{8},\nspnumber{1})\nspoperator{;}[x,kerA]=linsolve(A,b)\nspoperator{;}A\nspoperator{*}x\nspoperator{+}b\nspoperator{,}\nspcomment{//compatible b}
b=ones(\nspnumber{5},\nspnumber{1})\nspoperator{;}[x,kerA]=linsolve(A,b)\nspoperator{;}A\nspoperator{*}x\nspoperator{+}b\nspoperator{,}\nspcomment{//uncompatible b}
