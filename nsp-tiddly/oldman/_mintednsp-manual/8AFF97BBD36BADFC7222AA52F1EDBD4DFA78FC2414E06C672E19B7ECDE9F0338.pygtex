\begin{Verbatim}[commandchars=\\\{\}]
deff(\nspstring{'[z]=f(x,y)'},\nspstring{'z=x^2+y^2'})\nspoperator{;}
feval(\nspnumber{1}\nspoperator{:}\nspnumber{10},\nspnumber{1}\nspoperator{:}\nspnumber{5},f)
deff(\nspstring{'[z]=f(x,y)'},\nspstring{'z=x+\nsppc{}i*y'})\nspoperator{;}
feval(\nspnumber{1}\nspoperator{:}\nspnumber{10},\nspnumber{1}\nspoperator{:}\nspnumber{5},f)
feval(\nspnumber{1}\nspoperator{:}\nspnumber{10},\nspnumber{1}\nspoperator{:}\nspnumber{5},\nspstring{'parab'})\nspoperator{,}\nspcomment{//See ffeval.f file}
feval(\nspnumber{1}\nspoperator{:}\nspnumber{10},\nspstring{'parab'})
\nspcomment{// For dynamic link (see example ftest in ffeval.f)}
\nspcomment{// you can use the link command (the parameters depend on the machine):}
\nspcomment{// unix('make ftest.o');link('ftest.o','ftest); feval(1:10,1:5,'ftest')}
\end{Verbatim}
