\begin{Verbatim}[commandchars=\\\{\}]
F=randpencil([\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{2}],[\nspnumber{2}\nspoperator{,}\nspnumber{3}],[\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspnumber{3}\nspoperator{,}\nspnumber{1}],[\nspnumber{0}\nspoperator{,}\nspnumber{3}])\nspoperator{;}
Q=rand(\nspnumber{17},\nspnumber{17})\nspoperator{;}Z=rand(\nspnumber{18},\nspnumber{18})\nspoperator{;}F=Q\nspoperator{*}F\nspoperator{*}Z\nspoperator{;}
\nspcomment{//random pencil with eps1=1,eps2=1,eps3=1; 2 J-blocks @ infty}
\nspcomment{//with dimensions 2 and 3}
\nspcomment{//3 finite eigenvalues at -1,3,1 and eta1=0,eta2=3}
[Q,Z,Qd,Zd,numbeps,numbeta]=kroneck(F)\nspoperator{;}
[Qd(\nspnumber{1})\nspoperator{,}Zd(\nspnumber{1})]\nspoperator{,}\nspcomment{//eps. part is sum(epsi) x (sum(epsi) + number of epsi)}
[Qd(\nspnumber{2})\nspoperator{,}Zd(\nspnumber{2})]\nspoperator{,}\nspcomment{//infinity part}
[Qd(\nspnumber{3})\nspoperator{,}Zd(\nspnumber{3})]\nspoperator{,}\nspcomment{//finite part}
[Qd(\nspnumber{4})\nspoperator{,}Zd(\nspnumber{4})]\nspoperator{,}\nspcomment{//eta part is (sum(etai) + number(eta1)) x sum(etai)}
numbeps
numbeta
\end{Verbatim}
