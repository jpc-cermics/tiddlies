\begin{Verbatim}[commandchars=\\\{\}]
t=[\nspnumber{0}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{2}\nspoperator{*}%pi]\nspoperator{'}\nspoperator{;}
plot2d(sin(t),cos(t))
xbasc()
isoview(\nspoperator{-}\nspnumber{1},\nspnumber{1},\nspoperator{-}\nspnumber{1},\nspnumber{1})
plot2d(sin(t),cos(t),\nspnumber{1},\nspstring{"001"})
xset(\nspstring{"default"})
plot2d(sin(t),cos(t),frameflag = \nspnumber{4})
\end{Verbatim}
