\begin{Verbatim}[commandchars=\\\{\}]
W=ssrand(\nspnumber{2},\nspnumber{3},\nspnumber{5},list(\nspstring{'co'},\nspnumber{3}))\nspoperator{;}\nspcomment{//cont. subspace has dim 3.}
A=W(\nspstring{"A"})\nspoperator{;}B=W(\nspstring{"B"})\nspoperator{;}
[n,U]=contr(A,B)\nspoperator{;}n
A1=U\nspoperator{'}\nspoperator{*}A\nspoperator{*}U\nspoperator{;}
spec(A1(n\nspoperator{+}\nspnumber{1}\nspoperator{:}$,n\nspoperator{+}\nspnumber{1}\nspoperator{:}$))\nspoperator{,}\nspcomment{//uncontrollable modes}
spec(A\nspoperator{+}B\nspoperator{*}rand(\nspnumber{3},\nspnumber{5}))
\end{Verbatim}
