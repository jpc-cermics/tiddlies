\nspcomment{// plot without axis}
plot2d(x,sin(x),\nspnumber{1},\nspstring{"010"},\nspstring{" "},[\nspoperator{-}\nspnumber{4}\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspnumber{4}\nspoperator{,}\nspnumber{1}])
\nspcomment{// draw x axis}
xpoly([\nspoperator{-}\nspnumber{4}\nspoperator{,}\nspnumber{4}],[\nspnumber{0}\nspoperator{,}\nspnumber{0}],\nspstring{"lines"})
xaxis(\nspnumber{0},[\nspnumber{2}\nspoperator{,}\nspnumber{2}],[\nspnumber{2}\nspoperator{,}\nspnumber{0.1}\nspoperator{,}\nspnumber{3}],[\nspoperator{-}\nspnumber{4}\nspoperator{,}\nspnumber{0}])
xstring(\nspoperator{-}\nspnumber{4.1},\nspoperator{-}\nspnumber{0.25},\nspstring{"-4"})\nspoperator{;}xstring(\nspoperator{-}\nspnumber{0.2},\nspoperator{-}\nspnumber{0.1},\nspstring{"0"})\nspoperator{;}xstring(\nspnumber{4},\nspoperator{-}\nspnumber{0.25},\nspstring{"4"})
\nspcomment{// draw y axis}
