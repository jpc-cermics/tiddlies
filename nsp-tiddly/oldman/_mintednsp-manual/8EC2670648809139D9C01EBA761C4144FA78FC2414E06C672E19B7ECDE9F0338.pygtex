xaxis(\nspnumber{90},[\nspnumber{2}\nspoperator{,}\nspnumber{2}],[\nspnumber{0.5}\nspoperator{,}\nspnumber{0.025}\nspoperator{,}\nspnumber{3}],[\nspnumber{0}\nspoperator{,}\nspnumber{1}])
