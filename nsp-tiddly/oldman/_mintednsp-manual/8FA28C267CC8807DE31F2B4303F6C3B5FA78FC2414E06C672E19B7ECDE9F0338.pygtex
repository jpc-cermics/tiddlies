\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// example 1}
x=[\nspnumber{0}\nspoperator{,}%i\nspoperator{,}\nspoperator{-}%i]
tanh(atanh(x))
\nspcomment{// example 2}
x=[\nspoperator{-}%inf\nspoperator{,}\nspoperator{-}\nspnumber{3}\nspoperator{,}\nspoperator{-}\nspnumber{2}\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{3}\nspoperator{,}%inf]
ieee(\nspnumber{2})
atanh(tanh(x))
\nspcomment{// example 3 (see Remark)}
ieee(\nspnumber{2})
atanh([\nspnumber{1}\nspoperator{,}\nspnumber{2}])
atanh([\nspnumber{1}\nspoperator{,}\nspnumber{0.5}])
\end{Verbatim}
