\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{//P has two recurrent classes (with 2 and 1 states) 2 transient states}
P=genmarkov([\nspnumber{2}\nspoperator{,}\nspnumber{1}],\nspnumber{2})
[M,Q]=eigenmarkov(P)\nspoperator{;}
P\nspoperator{*}Q\nspoperator{-}Q
Q\nspoperator{*}M\nspoperator{-}P\nspoperator{^}\nspnumber{20}
