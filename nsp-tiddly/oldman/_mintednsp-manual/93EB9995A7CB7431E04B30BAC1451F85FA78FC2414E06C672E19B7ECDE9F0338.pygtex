\begin{Verbatim}[commandchars=\\\{\}]
execstr(\nspstring{'a=1'})\nspoperator{,}\nspcomment{// sets a=1.}
execstr(\nspstring{'1+1'})\nspoperator{,}\nspcomment{// does nothing (while evstr('1+1') returns 2)}
execstr([\nspstring{'if \nsppc{}t then'}\nspoperator{;}\nspstring{'  a=1'}\nspoperator{;}\nspstring{'  b=a+1'}\nspoperator{;}\nspstring{'else'}\nspoperator{;}\nspstring{' b=0'}\nspoperator{;}\nspstring{'end'}])
execstr(\nspstring{'a=zzzzzzz'},\nspstring{'errcatch'})
execstr(\nspstring{'a=zzzzzzz'},\nspstring{'errcatch'},\nspstring{'m'})
\end{Verbatim}
