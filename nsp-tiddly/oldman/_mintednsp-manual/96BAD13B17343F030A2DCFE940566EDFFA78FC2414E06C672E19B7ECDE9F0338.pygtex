\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// A is the sparse matrix:}
A=[\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{;}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{;}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{;}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{;}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{;}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{;}
   \nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{1}]\nspoperator{;}
A=sparse(A)\nspoperator{;}
\nspcomment{//For this matrix, the standard adjacency representation is given by:}
xadj=[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{3}\nspoperator{,}\nspnumber{8}\nspoperator{,}\nspnumber{12}\nspoperator{,}\nspnumber{13}\nspoperator{,}\nspnumber{15}\nspoperator{,}\nspnumber{16}]\nspoperator{;}
adjncy=[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{3}\nspoperator{,}\nspnumber{4}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{7}\nspoperator{,}\nspnumber{4}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{7}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{7}\nspoperator{,}\nspnumber{7}]\nspoperator{;}
\nspcomment{//(see sp2adj).}
\nspcomment{// increments in vector xadj give the number of non zero entries in each column}
\nspcomment{// ie there is 2-1=1 entry in the column 1}
\nspcomment{//    there is 3-2=1 entry in the column 2}
\nspcomment{//    there are 8-3=5 entries in the column 3}
\nspcomment{//              12-8=4                      4}
\nspcomment{//etc}
\nspcomment{//The row index of these entries is given by the adjncy vector}
\nspcomment{// for instance,}
\nspcomment{// adjncy (3:7)=adjncy(xadj(3):xadj(4)-1)=[3,4,5,6,7]}
\nspcomment{// says that the 5=xadj(4)-xadj(3) entries in column 3 have row}
\nspcomment{// indices 3,4,5,6,7.}
\nspcomment{//In the compact representation, the repeated sequences in adjncy}
\nspcomment{//are eliminated.}
\nspcomment{//Here in adjncy the sequences 4,5,6,7  and 7 are eliminated.}
\nspcomment{//The standard structure (xadj,adjncy) takes the compressed form (lindx,xlindx)}
lindx=[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{3}\nspoperator{,}\nspnumber{4}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{7}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{7}]\nspoperator{;}
xlindx=[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{3}\nspoperator{,}\nspnumber{8}\nspoperator{,}\nspnumber{9}\nspoperator{,}\nspnumber{11}]\nspoperator{;}
\nspcomment{//(Columns 4 and 7 of A are eliminated).}
\nspcomment{//A can be reconstructed from (xadj,xlindx,lindx).}
[xadj,adjncy,anz]=sp2adj(A)\nspoperator{;}
adjncy\nspoperator{-}spcompack(xadj,xlindx,lindx)
\end{Verbatim}
