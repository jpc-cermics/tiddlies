\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{//Real case: 1x1 and 2x2 blocks}
a=rand(\nspnumber{5},\nspnumber{5})\nspoperator{;}[ab,x,bs]=bdiag(a)\nspoperator{;}ab
\nspcomment{//Complex case: complex 1x1 blocks}
[ab,x,bs]=bdiag(a\nspoperator{+}%i\nspoperator{*}\nspnumber{0})\nspoperator{;}ab
\end{Verbatim}
