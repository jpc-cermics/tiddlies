\begin{Verbatim}[commandchars=\\\{\}]
set(\nspstring{"figure_style"},\nspstring{"new"})\nspoperator{,}\nspcomment{//create a figure}
a=get(\nspstring{"current_axes"})\nspoperator{;}\nspcomment{//get the handle of the newly created axes}
a.data_bounds=[\nspoperator{-}\nspnumber{2}\nspoperator{,}\nspoperator{-}\nspnumber{2}\nspoperator{;}\nspnumber{2}\nspoperator{,}\nspnumber{2}]\nspoperator{;}
xarc(\nspoperator{-}\nspnumber{1.5},\nspnumber{1.5},\nspnumber{3},\nspnumber{3},\nspnumber{0},\nspnumber{360}\nspoperator{*}\nspnumber{64})
arc=get(\nspstring{"hdl"})\nspoperator{;}\nspcomment{//get handle on current entity (here the arc entity)}
arc.fill_mode=\nspstring{"on"}\nspoperator{;}
arc.foreground=\nspnumber{5}\nspoperator{;}
arc.data(\nspoperator{:},[\nspnumber{3}\nspoperator{,}\nspnumber{6}])=[\nspnumber{2}\nspoperator{,}\nspnumber{270}\nspoperator{*}\nspnumber{64}]\nspoperator{;}
xfarc(\nspoperator{-}\nspnumber{.5},\nspnumber{1},\nspnumber{.4},\nspnumber{.6},\nspnumber{0},\nspnumber{360}\nspoperator{*}\nspnumber{64})\nspoperator{;}
arc.visible=\nspstring{"off"}\nspoperator{;}
\end{Verbatim}
