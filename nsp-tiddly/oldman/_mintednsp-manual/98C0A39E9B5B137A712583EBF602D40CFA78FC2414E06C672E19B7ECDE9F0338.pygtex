\begin{Verbatim}[commandchars=\\\{\}]
A=[\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{4}\nspoperator{;}\nspnumber{5}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{7}\nspoperator{,}\nspnumber{8}\nspoperator{;}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{11}\nspoperator{,}\nspnumber{12}\nspoperator{;}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{16}]\nspoperator{;}
B=[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}]\nspoperator{'}\nspoperator{;}C=[\nspnumber{4}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}]\nspoperator{;}
Sl=ss2ss(syslin(\nspstring{'c'},A,B,C),rand(A))\nspoperator{;}
[no,X]=contr(Sl(\nspstring{'A'}),Sl(\nspstring{'B'}))\nspoperator{;}CO=X(\nspoperator{:},\nspnumber{1}\nspoperator{:}no)\nspoperator{;}\nspcomment{//Controllable part}
