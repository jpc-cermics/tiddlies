\begin{Verbatim}[commandchars=\\\{\}]
backupstyle=\nspstring{'?'}
\nspkeyword{if} (get(\nspstring{'old_style'})\nspoperator{==}\nspstring{'off'}) \nspkeyword{then}
  set(\nspstring{'old_style'},\nspstring{'on'})\nspoperator{;}
  backupstyle=\nspstring{'off'}
\nspkeyword{end}
x=[\nspnumber{0}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{2}\nspoperator{*}%pi]\nspoperator{'}\nspoperator{;}
plot2d(x,sin(x))
replot([\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspnumber{10}\nspoperator{,}\nspnumber{2}])
\nspkeyword{if} (backupstyle\nspoperator{==}\nspstring{'off'}) \nspkeyword{then} set(\nspstring{'old_style'},backupstyle)\nspoperator{;}\nspkeyword{end}\nspoperator{;}
\end{Verbatim}
