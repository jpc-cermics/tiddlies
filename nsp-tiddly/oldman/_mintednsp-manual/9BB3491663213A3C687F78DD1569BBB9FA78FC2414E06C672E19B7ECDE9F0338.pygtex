\begin{Verbatim}[commandchars=\\\{\}]
g=load_graph(SCI\nspoperator{+}\nspstring{'/demos/metanet/colored'})\nspoperator{;}
show_graph(g)\nspoperator{;}
a=graph_2_mat(g)\nspoperator{;}
g1=mat_2_graph(a,\nspnumber{1})\nspoperator{;}
g1(\nspstring{'node_x'})=g(\nspstring{'node_x'})\nspoperator{;}g1(\nspstring{'node_y'})=g(\nspstring{'node_y'})\nspoperator{;}
show_graph(g1,\nspstring{'new'})\nspoperator{;}
a=graph_2_mat(g,\nspstring{'node-node'})\nspoperator{;}
g1=mat_2_graph(a,\nspnumber{1},\nspstring{'node-node'})\nspoperator{;}
g1(\nspstring{'node_x'})=g(\nspstring{'node_x'})\nspoperator{;}g1(\nspstring{'node_y'})=g(\nspstring{'node_y'})\nspoperator{;}
show_graph(g1,\nspstring{'new'})\nspoperator{;}
\end{Verbatim}
