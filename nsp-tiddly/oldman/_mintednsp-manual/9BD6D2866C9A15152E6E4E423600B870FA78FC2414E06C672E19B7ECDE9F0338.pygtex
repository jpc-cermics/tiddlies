\begin{Verbatim}[commandchars=\\\{\}]
A=rand(\nspnumber{1},\nspnumber{20})\nspoperator{;}
w=find(A\nspoperator{ < }\nspnumber{0.4})
A(w)
w=find(A\nspoperator{ > }\nspnumber{100})
B=rand(\nspnumber{1},\nspnumber{20})\nspoperator{;}
w=find(B\nspoperator{ < }\nspnumber{0.4},\nspnumber{2})\nspoperator{,}\nspcomment{//at most 2 returned values}
H=rand(\nspnumber{4},\nspnumber{3},\nspnumber{5})\nspoperator{;}\nspcomment{//an hypermatrix}
[i,j,k]=find(H\nspoperator{ > }\nspnumber{0.9})
H(i(\nspnumber{1}),j(\nspnumber{1}),k(\nspnumber{1}))
\end{Verbatim}
