\begin{Verbatim}[commandchars=\\\{\}]
l1=list(\nspstring{'choice 1'},\nspnumber{1},[\nspstring{'toggle c1'}\nspoperator{,}\nspstring{'toggle c2'}\nspoperator{,}\nspstring{'toggle c3'}])\nspoperator{;}
l2=list(\nspstring{'choice 2'},\nspnumber{2},[\nspstring{'toggle d1'}\nspoperator{,}\nspstring{'toggle d2'}\nspoperator{,}\nspstring{'toggle d3'}])\nspoperator{;}
l3=list(\nspstring{'choice 3'},\nspnumber{3},[\nspstring{'toggle e1'}\nspoperator{,}\nspstring{'toggle e2'}])\nspoperator{;}
rep=x_choices(\nspstring{'Toggle Menu'},list(l1,l2,l3))\nspoperator{;}
