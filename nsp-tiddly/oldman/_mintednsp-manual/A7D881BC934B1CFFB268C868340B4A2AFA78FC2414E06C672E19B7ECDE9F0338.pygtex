\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{//DISPLAY}
deff(\nspstring{'[]=\nsppc{}tab_p(l)'},\nspstring{'disp([['' '';l(3)] [l(2);string(l(4))]])'})
tlist(\nspstring{'tab'},[\nspstring{'a'}\nspoperator{,}\nspstring{'b'}],[\nspstring{'x'}\nspoperator{;}\nspstring{'y'}],rand(\nspnumber{2},\nspnumber{2}))
\nspcomment{//OPERATOR}
deff(\nspstring{'x=\nsppc{}c_a_s(a,b)'},\nspstring{'x=a+string(b)'})
\nspstring{'s'}\nspoperator{+}\nspnumber{1}
\nspcomment{//FUNCTION}
deff(\nspstring{'x=\nsppc{}c_sin(a)'},\nspstring{'x=''sin(''+a+'')'''})
sin(\nspstring{'2*x'})
\end{Verbatim}
