h=syslin(\nspstring{'c'},\nspnumber{1}\nspoperator{/}((s\nspoperator{+}\nspnumber{5})\nspoperator{*}(s\nspoperator{+}\nspnumber{10})\nspoperator{*}(\nspnumber{100}\nspoperator{+}\nspnumber{6}\nspoperator{*}s\nspoperator{+}s\nspoperator{*}s)\nspoperator{*}(s\nspoperator{+}\nspnumber{.3})))\nspoperator{;}
