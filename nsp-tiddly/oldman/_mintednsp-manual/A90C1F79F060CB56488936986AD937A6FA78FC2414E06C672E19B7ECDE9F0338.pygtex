\begin{Verbatim}[commandchars=\\\{\}]
s=%s\nspoperator{;}
w=[\nspnumber{1}\nspoperator{/}s\nspoperator{,}\nspnumber{0}\nspoperator{;}s\nspoperator{/}(s\nspoperator{^}\nspnumber{3}\nspoperator{+}\nspnumber{2})\nspoperator{,}\nspnumber{2}\nspoperator{/}s]\nspoperator{;}
Sl=tf2ss(w)\nspoperator{;}
[Stmp,Ws]=rowregul(Sl,\nspoperator{-}\nspnumber{1},\nspoperator{-}\nspnumber{2})\nspoperator{;}
Stmp(\nspstring{'D'})\nspoperator{,}\nspcomment{// D matrix of Stmp}
clean(ss2tf(Stmp))
\end{Verbatim}
