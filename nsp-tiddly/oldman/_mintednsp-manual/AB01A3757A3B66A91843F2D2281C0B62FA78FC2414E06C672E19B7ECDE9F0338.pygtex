\begin{Verbatim}[commandchars=\\\{\}]
h=figure()\nspoperator{;}
\nspcomment{// creates  figure number 1.}
uicontrol(h,\nspstring{'style'},\nspstring{'text'},\nspstring{'string'},\nspstring{'This is a figure'},\nspstring{'position'},[\nspnumber{50}\nspoperator{,}\nspnumber{70}\nspoperator{,}\nspnumber{100}\nspoperator{,}\nspnumber{100}], ...
          \nspstring{'fontsize'},\nspnumber{15},\nspstring{'tag'},\nspstring{'Alabel'})\nspoperator{;}
\nspcomment{// put a  text in figure 1}
lab=findobj(\nspstring{'tag'},\nspstring{'Alabel'})\nspoperator{;}
\nspcomment{// find the object which 'tag' value is 'Alabel'}
disp(\nspstring{'the handle of the label is '}\nspoperator{+}string(lab))\nspoperator{;}
close()\nspoperator{;}
\end{Verbatim}
