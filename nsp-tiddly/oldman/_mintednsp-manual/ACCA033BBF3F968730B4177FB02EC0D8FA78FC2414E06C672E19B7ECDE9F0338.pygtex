\begin{Verbatim}[commandchars=\\\{\}]
g=load_graph(SCI\nspoperator{+}\nspstring{'/demos/metanet/mesh100'})\nspoperator{;}
show_graph(g)\nspoperator{;}
\nspkeyword{if} MSDOS \nspkeyword{then}
  unix(\nspstring{'del mymesh100.graph'})\nspoperator{;}
\nspkeyword{else}
  unix(\nspstring{'rm -f mymesh100.graph'})\nspoperator{;}
\nspkeyword{end}
save_graph(g,\nspstring{'mymesh100.graph'})\nspoperator{;}
g=load_graph(\nspstring{'mymesh100'})\nspoperator{;}
show_graph(g,\nspstring{'new'})\nspoperator{;}
\end{Verbatim}
