\begin{Verbatim}[commandchars=\\\{\}]
deff(\nspstring{"[xdot] = derpol(t,x)"}, ...
     [\nspstring{"xd1 = x(2)"}\nspoperator{;}\nspstring{"xd2 = -x(1) + (1 - x(1)**2)*x(2)"}\nspoperator{;}\nspstring{"xdot = [ xd1 ; xd2 ]"}])
xf=\nspoperator{-}\nspnumber{1}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{1}\nspoperator{;}
yf=\nspoperator{-}\nspnumber{1}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{1}\nspoperator{;}
fchamp(derpol,\nspnumber{0},xf,yf)
clf()
fchamp(derpol,\nspnumber{0},xf,yf,\nspnumber{1},[\nspoperator{-}\nspnumber{2}\nspoperator{,}\nspoperator{-}\nspnumber{2}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{2}],\nspstring{"011"})
\end{Verbatim}
