\nspcomment{//polynomial case}
s=poly(\nspnumber{0},\nspstring{'s'})\nspoperator{;}
p=[s\nspoperator{,}s\nspoperator{*}(s\nspoperator{+}\nspnumber{1})\nspoperator{^}\nspnumber{2}\nspoperator{,}s\nspoperator{^}\nspnumber{2}\nspoperator{*}(s\nspoperator{+}\nspnumber{2})]\nspoperator{;}
[pp,fact]=lcm(p)\nspoperator{;}
p\nspoperator{ .*}fact\nspoperator{,}pp
\nspcomment{//integer case}
V=int32([\nspnumber{2}\nspoperator{^}\nspnumber{2}\nspoperator{*}\nspnumber{3}\nspoperator{^}\nspnumber{5}\nspoperator{,}\nspnumber{2}\nspoperator{^}\nspnumber{3}\nspoperator{*}\nspnumber{3}\nspoperator{^}\nspnumber{2}\nspoperator{,}\nspnumber{2}\nspoperator{^}\nspnumber{2}\nspoperator{*}\nspnumber{3}\nspoperator{^}\nspnumber{4}\nspoperator{*}\nspnumber{5}])\nspoperator{;}
