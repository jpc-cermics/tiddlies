\begin{Verbatim}[commandchars=\\\{\}]
a=eye(\nspnumber{2},\nspnumber{2})\nspoperator{;}b=ones(a)\nspoperator{;}
oldsave(\nspstring{'TMPDIR/val.dat'},a,b)\nspoperator{;}
\nspkeyword{clear} a
\nspkeyword{clear} b
oldload(\nspstring{'TMPDIR/val.dat'},\nspstring{'a'},\nspstring{'b'})\nspoperator{;}
\end{Verbatim}
