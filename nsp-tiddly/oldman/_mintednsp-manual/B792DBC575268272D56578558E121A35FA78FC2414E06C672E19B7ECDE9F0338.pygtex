\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// Caution: this example may not work if your system have not}
\nspcomment{//           the schoolbook bold font}
\nspkeyword{if} MSDOS \nspkeyword{then}
  xlfont(\nspstring{"Century Schoolbook Bold"},\nspnumber{10})
\nspkeyword{else}
  xlfont(\nspstring{"-adobe-new century schoolbook-bold-r-normal-*-\nsppc{}s-*-75-75-*-*-iso8859-1"},\nspnumber{10})
\nspkeyword{end}
xbasc()
xset(\nspstring{"font"},\nspnumber{6},\nspnumber{2})\nspoperator{,}\nspcomment{// use helvetica at 12 pts}
plot2d()
xset(\nspstring{"font"},\nspnumber{10},\nspnumber{4})\nspoperator{,}\nspcomment{// use Schoolbook bold at 18 pts}
xtitle(\nspstring{"plot2d demo"},\nspstring{"x"},\nspstring{"y"})
\end{Verbatim}
