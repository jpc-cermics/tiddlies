\begin{Verbatim}[commandchars=\\\{\}]
x=[\nspnumber{1}\nspoperator{+}%i\nspoperator{,}\nspoperator{-}%i\nspoperator{;}%i\nspoperator{,}\nspnumber{2}\nspoperator{*}%i]\nspoperator{;}
conj(x)
