\begin{Verbatim}[commandchars=\\\{\}]
g=load_graph(SCI\nspoperator{+}\nspstring{'/demos/metanet/mesh100'})\nspoperator{;}
g(\nspstring{'node_color'})=int(rand(\nspnumber{1}\nspoperator{:}g(\nspstring{'node_number'}))\nspoperator{*}\nspnumber{16})\nspoperator{;}
g(\nspstring{'edge_color'})=int(rand(\nspnumber{1}\nspoperator{:}edge_number(g))\nspoperator{*}\nspnumber{16})\nspoperator{;}
show_graph(g)
\end{Verbatim}
