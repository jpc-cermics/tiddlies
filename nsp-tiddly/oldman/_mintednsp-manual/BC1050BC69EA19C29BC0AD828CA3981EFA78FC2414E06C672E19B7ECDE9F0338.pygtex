\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{//Find x in R^6 such that:}
\nspcomment{//C1*x = b1 (3 equality constraints i.e me=3)}
C1=[\nspnumber{1}\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{3}\nspoperator{,}\nspnumber{1}\nspoperator{;}\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspoperator{-}\nspnumber{3}\nspoperator{,}\nspoperator{-}\nspnumber{4}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{6}\nspoperator{;}\nspnumber{2}\nspoperator{,}\nspnumber{5}\nspoperator{,}\nspnumber{3}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}]\nspoperator{;}
b1=[\nspnumber{1}\nspoperator{;}\nspnumber{2}\nspoperator{;}\nspnumber{3}]\nspoperator{;}
\nspcomment{//C2*x $<$= b2 (2 inequality constraints)}
C2=[\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{;}\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}]\nspoperator{;}
b2=[\nspoperator{-}\nspnumber{1}\nspoperator{;}\nspnumber{2.5}]\nspoperator{;}
\nspcomment{//with  x between ci and cs:}
ci=[\nspoperator{-}\nspnumber{1000}\nspoperator{;}\nspoperator{-}\nspnumber{10000}\nspoperator{;}\nspnumber{0}\nspoperator{;}\nspoperator{-}\nspnumber{1000}\nspoperator{;}\nspoperator{-}\nspnumber{1000}\nspoperator{;}\nspoperator{-}\nspnumber{1000}]\nspoperator{;}cs=[\nspnumber{10000}\nspoperator{;}\nspnumber{100}\nspoperator{;}\nspnumber{1.5}\nspoperator{;}\nspnumber{100}\nspoperator{;}\nspnumber{100}\nspoperator{;}\nspnumber{1000}]\nspoperator{;}
\nspcomment{//and minimize 0.5*x'*Q*x + p'*x with}
p=[\nspnumber{1}\nspoperator{;}\nspnumber{2}\nspoperator{;}\nspnumber{3}\nspoperator{;}\nspnumber{4}\nspoperator{;}\nspnumber{5}\nspoperator{;}\nspnumber{6}]\nspoperator{;}Q=eye(\nspnumber{6},\nspnumber{6})\nspoperator{;}
\nspcomment{//No initial point is given;}
C=[C1\nspoperator{;}C2]\nspoperator{;}\nspcomment{//}
b=[b1\nspoperator{;}b2]\nspoperator{;}\nspcomment{//}
me=\nspnumber{3}\nspoperator{;}
[x,lagr,f]=quapro(Q,p,C,b,ci,cs,me)
\nspcomment{//Only linear constraints (1 to 4) are active (lagr(1:6)=0):}
[x,lagr,f]=quapro(Q,p,C,b,[],[],me)\nspoperator{,}\nspcomment{//Same result as above}
\end{Verbatim}
