\begin{Verbatim}[commandchars=\\\{\}]
h=figure(\nspnumber{3})\nspoperator{;}
\nspcomment{// creates  figure number 1.}
uicontrol(h,\nspstring{'style'},\nspstring{'text'},\nspstring{'string'},\nspstring{'This is a figure'},\nspstring{'position'},[\nspnumber{50}\nspoperator{,}\nspnumber{70}\nspoperator{,}\nspnumber{100}\nspoperator{,}\nspnumber{100}], ...
          \nspstring{'fontsize'},\nspnumber{15})\nspoperator{;}
\nspcomment{// put a  text in figure 3}
figure()\nspoperator{;}
\nspcomment{// create figure 1}
uicontrol(\nspstring{'style'},\nspstring{'text'},\nspstring{'string'},\nspstring{'Another figure'},\nspstring{'position'},[\nspnumber{50}\nspoperator{,}\nspnumber{70}\nspoperator{,}\nspnumber{100}\nspoperator{,}\nspnumber{100}],\nspstring{'fontsize'}, ...
          \nspnumber{15})\nspoperator{;}
\nspcomment{// put a text in figure 1}
close()\nspoperator{;}
\nspcomment{// close the current graphic window (ie fig. 1)}
close(h)\nspoperator{;}
\nspcomment{// close figure 3}
\end{Verbatim}
