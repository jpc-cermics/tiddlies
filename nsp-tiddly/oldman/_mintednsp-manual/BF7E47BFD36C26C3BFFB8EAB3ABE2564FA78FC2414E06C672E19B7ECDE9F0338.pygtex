\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// polynomial case}
x=poly(\nspnumber{0},\nspstring{'x'})\nspoperator{;}
p1=(x\nspoperator{+}\nspnumber{1})\nspoperator{*}(x\nspoperator{-}\nspnumber{3})\nspoperator{^}\nspnumber{5}\nspoperator{;}p2=(x\nspoperator{-}\nspnumber{2})\nspoperator{*}(x\nspoperator{-}\nspnumber{3})\nspoperator{^}\nspnumber{3}\nspoperator{;}
[thegcd,U]=bezout(p1,p2)
det(U)
clean([p1\nspoperator{,}p2]\nspoperator{*}U)
thelcm=p1\nspoperator{*}U(\nspnumber{1},\nspnumber{2})
lcm([p1\nspoperator{,}p2])
\nspcomment{// integer case}
i1=int32(\nspnumber{2}\nspoperator{*}\nspnumber{3}\nspoperator{^}\nspnumber{5})\nspoperator{;}i2=int32(\nspnumber{2}\nspoperator{^}\nspnumber{3}\nspoperator{*}\nspnumber{3}\nspoperator{^}\nspnumber{2})\nspoperator{;}
[thegcd,U]=bezout(i1,i2)
V=int32([\nspnumber{2}\nspoperator{^}\nspnumber{2}\nspoperator{*}\nspnumber{3}\nspoperator{^}\nspnumber{5}\nspoperator{,}\nspnumber{2}\nspoperator{^}\nspnumber{3}\nspoperator{*}\nspnumber{3}\nspoperator{^}\nspnumber{2}\nspoperator{,}\nspnumber{2}\nspoperator{^}\nspnumber{2}\nspoperator{*}\nspnumber{3}\nspoperator{^}\nspnumber{4}\nspoperator{*}\nspnumber{5}])\nspoperator{;}
[thegcd,U]=gcd(V)
V\nspoperator{*}U
lcm(V)
\end{Verbatim}
