\begin{Verbatim}[commandchars=\\\{\}]
A=sprand(\nspnumber{20},\nspnumber{20},\nspnumber{0.1})\nspoperator{;}
A=A\nspoperator{*}A\nspoperator{'}\nspoperator{+}eye()\nspoperator{;}
