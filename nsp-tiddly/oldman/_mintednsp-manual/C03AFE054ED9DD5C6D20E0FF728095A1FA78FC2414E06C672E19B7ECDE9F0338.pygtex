\begin{Verbatim}[commandchars=\\\{\}]
i=\nspnumber{2}
\nspkeyword{for} j=\nspnumber{1}\nspoperator{:}\nspnumber{3} \nspkeyword{do}
  \nspkeyword{if} i\nspoperator{==}j \nspkeyword{then}
    a(i,j)=\nspnumber{2}\nspoperator{;}
  \nspkeyword{elseif} abs(i\nspoperator{-}j)\nspoperator{==}\nspnumber{1} \nspkeyword{then}
    a(i,j)=\nspoperator{-}\nspnumber{1}\nspoperator{;}
  \nspkeyword{else}
    a(i,j)=\nspnumber{0}\nspoperator{;}
  \nspkeyword{end}\nspoperator{,}
\nspkeyword{end}
\end{Verbatim}
