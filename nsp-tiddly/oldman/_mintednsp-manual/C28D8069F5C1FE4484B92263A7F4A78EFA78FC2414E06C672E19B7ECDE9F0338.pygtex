h=gce()\nspoperator{;}\nspcomment{//get handle on current entity (here the surface)}
a=gca()\nspoperator{;}\nspcomment{//get current axes}
a.rotation_angles=[\nspnumber{40}\nspoperator{,}\nspnumber{70}]\nspoperator{;}
a.grid=[\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{1}]\nspoperator{;}\nspcomment{//make grids}
a.data_bounds=[\nspoperator{-}\nspnumber{6}\nspoperator{,}\nspnumber{6}\nspoperator{;}\nspnumber{6}\nspoperator{,}\nspoperator{-}\nspnumber{1}\nspoperator{;}\nspnumber{0}\nspoperator{,}\nspnumber{5}]\nspoperator{;}
a.axes_visible=\nspstring{"off"}\nspoperator{;}\nspcomment{//axes are hidden}
a.axes_bounds=[\nspnumber{.2}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{1}]\nspoperator{;}
