delete(gcf())\nspoperator{;}
t=[\nspnumber{0}\nspoperator{:}\nspnumber{0.3}\nspoperator{:}\nspnumber{2}\nspoperator{*}%pi]\nspoperator{'}\nspoperator{;}z=sin(t)\nspoperator{*}cos(t\nspoperator{'})\nspoperator{;}
