h.color_mode=\nspoperator{-}\nspnumber{2}\nspoperator{;}\nspcomment{//remove the facets boundary by setting color_mode to white color}
h.color_flag=\nspnumber{2}\nspoperator{;}\nspcomment{//color according to given colors}
h.color_mode=\nspoperator{-}\nspnumber{1}\nspoperator{;}\nspcomment{// put the facets boundary back by setting color_mode to black color}
f=gcf()\nspoperator{;}\nspcomment{//get the handle of the parent figure}
f.color_map=hotcolormap(\nspnumber{512})\nspoperator{;}
