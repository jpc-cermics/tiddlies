\nspcomment{// simple plot using z=f(x,y)}
t=[\nspnumber{0}\nspoperator{:}\nspnumber{0.3}\nspoperator{:}\nspnumber{2}\nspoperator{*}%pi]\nspoperator{'}\nspoperator{;}
z=sin(t)\nspoperator{*}cos(t\nspoperator{'})\nspoperator{;}
plot3d(t,t,z)
\nspcomment{// same plot using facets computed by genfac3d}
[xx,yy,zz]=genfac3d(t,t,z)\nspoperator{;}
clf()
