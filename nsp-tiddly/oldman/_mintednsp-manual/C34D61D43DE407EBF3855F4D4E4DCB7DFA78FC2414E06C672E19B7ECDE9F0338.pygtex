\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{// elemlib is a predefined library}
elemlib\nspoperator{,}\nspcomment{//displays the contents of the library}
A=rand(\nspnumber{3},\nspnumber{3})\nspoperator{;}
cosm(A)\nspoperator{,}\nspcomment{//loads cosm and executes it}
\nspkeyword{who} // now cosm is a variable
elemlib.sinm\nspoperator{,}\nspcomment{//loads sinm from the library}
elemlib.cosm(A)\nspoperator{,}\nspcomment{//reloads cosm and executes it}
\end{Verbatim}
