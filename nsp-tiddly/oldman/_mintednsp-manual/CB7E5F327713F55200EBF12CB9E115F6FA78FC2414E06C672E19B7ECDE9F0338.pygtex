\begin{Verbatim}[commandchars=\\\{\}]
A=rand(\nspnumber{2},\nspnumber{2})\nspoperator{;}B=rand(\nspnumber{2},\nspnumber{1})\nspoperator{;}\nspcomment{//two states, one input}
Q=diag([\nspnumber{2}\nspoperator{,}\nspnumber{5}])\nspoperator{;}R=\nspnumber{2}\nspoperator{;}\nspcomment{//Usual notations x'Qx + u'Ru}
Big=sysdiag(Q,R)\nspoperator{;}\nspcomment{//Now we calculate C1 and D12}
[w,wp]=fullrf(Big)\nspoperator{;}C1=wp(\nspoperator{:},\nspnumber{1}\nspoperator{:}\nspnumber{2})\nspoperator{;}D12=wp(\nspoperator{:},\nspnumber{3}\nspoperator{:}$)\nspoperator{;}\nspcomment{//[C1,D12]'*[C1,D12]=Big}
P=syslin(\nspstring{'c'},A,B,C1,D12)\nspoperator{;}\nspcomment{//The plant (continuous-time)}
[K,X]=lqr(P)
spec(A\nspoperator{+}B\nspoperator{*}K)\nspoperator{,}\nspcomment{//check stability}
norm(A\nspoperator{'}\nspoperator{*}X\nspoperator{+}X\nspoperator{*}A\nspoperator{-}X\nspoperator{*}B\nspoperator{*}inv(R)\nspoperator{*}B\nspoperator{'}\nspoperator{*}X\nspoperator{+}Q,\nspnumber{1})\nspoperator{,}\nspcomment{//Riccati check}
P=syslin(\nspstring{'d'},A,B,C1,D12)\nspoperator{;}\nspcomment{// Discrete time plant}
[K,X]=lqr(P)
spec(A\nspoperator{+}B\nspoperator{*}K)\nspoperator{,}\nspcomment{//check stability}
norm(A\nspoperator{'}\nspoperator{*}X\nspoperator{*}A\nspoperator{-}(A\nspoperator{'}\nspoperator{*}X\nspoperator{*}B)\nspoperator{*}pinv(B\nspoperator{'}\nspoperator{*}X\nspoperator{*}B\nspoperator{+}R)\nspoperator{*}(B\nspoperator{'}\nspoperator{*}X\nspoperator{*}A)\nspoperator{+}Q\nspoperator{-}X,\nspnumber{1})\nspoperator{,}\nspcomment{//Riccati check}
\end{Verbatim}
