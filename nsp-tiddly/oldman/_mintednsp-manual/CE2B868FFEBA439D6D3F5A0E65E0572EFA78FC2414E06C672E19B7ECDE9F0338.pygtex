\begin{Verbatim}[commandchars=\\\{\}]
x=\nspnumber{1}\nspoperator{:}\nspnumber{3}\nspoperator{;}
h1=[\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}]\nspoperator{;}h2=[\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}]\nspoperator{;}h3=[\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{1}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0}]\nspoperator{;}
x1=convol(h1,x)\nspoperator{,}x2=convol(h2,x)\nspoperator{,}x3=convol(h3,x)\nspoperator{,}
convol(h1\nspoperator{+}h2\nspoperator{+}h3,x)
p1=poly(x,\nspstring{'x'},\nspstring{'coeff'})
p2=poly(h1\nspoperator{+}h2\nspoperator{+}h3,\nspstring{'x'},\nspstring{'coeff'})
p1\nspoperator{*}p2
\end{Verbatim}
