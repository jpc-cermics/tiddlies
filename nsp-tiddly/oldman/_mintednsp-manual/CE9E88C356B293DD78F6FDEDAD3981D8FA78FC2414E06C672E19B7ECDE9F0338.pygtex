\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{//squared magnitude response of Butterworth filter}
h=buttmag(\nspnumber{13},\nspnumber{300},\nspnumber{1}\nspoperator{:}\nspnumber{1000})\nspoperator{;}
mag=\nspnumber{20}\nspoperator{*}log(h)\nspoperator{'}\nspoperator{/}log(\nspnumber{10})\nspoperator{;}
plot2d((\nspnumber{1}\nspoperator{:}\nspnumber{1000})\nspoperator{'},mag,[\nspnumber{2}],\nspstring{"011"},\nspstring{" "},[\nspnumber{0}\nspoperator{,}\nspoperator{-}\nspnumber{180}\nspoperator{,}\nspnumber{1000}\nspoperator{,}\nspnumber{20}])
\end{Verbatim}
