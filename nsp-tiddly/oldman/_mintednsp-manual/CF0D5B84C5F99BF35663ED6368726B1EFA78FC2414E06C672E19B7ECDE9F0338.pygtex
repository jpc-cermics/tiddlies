\begin{Verbatim}[commandchars=\\\{\}]
set(\nspstring{"figure_style"},\nspstring{"new"})\nspoperator{,}\nspcomment{//create a figure}
a=get(\nspstring{"current_axes"})\nspoperator{;}\nspcomment{//get the handle of the newly created axes}
a.data_bounds=[\nspoperator{-}\nspnumber{2}\nspoperator{,}\nspnumber{2}\nspoperator{;}\nspoperator{-}\nspnumber{2}\nspoperator{,}\nspnumber{2}]\nspoperator{;}
xrect(\nspoperator{-}\nspnumber{1},\nspnumber{1},\nspnumber{2},\nspnumber{2})
r=get(\nspstring{"hdl"})\nspoperator{;}\nspcomment{//get handle on current entity (here the rectangle entity)}
r.type
r.parent.type
r.foreground=\nspnumber{13}\nspoperator{;}
r.line_style=\nspnumber{2}\nspoperator{;}
r.fill_mode=\nspstring{"on"}\nspoperator{;}
r.clip_box=[\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspnumber{1}\nspoperator{;}\nspnumber{1}\nspoperator{,}\nspnumber{1}]\nspoperator{;}
r.data(\nspoperator{:},[\nspnumber{3}\nspoperator{,}\nspnumber{4}])=[\nspnumber{1}\nspoperator{/}\nspnumber{2}\nspoperator{,}\nspnumber{1}\nspoperator{/}\nspnumber{2}]\nspoperator{;}
r.data(\nspoperator{:},[\nspnumber{1}\nspoperator{,}\nspnumber{2}])=[\nspnumber{1}\nspoperator{/}\nspnumber{2}\nspoperator{,}\nspnumber{1}\nspoperator{/}\nspnumber{2}]\nspoperator{;}
r.clip_state=\nspstring{"off"}
\end{Verbatim}
