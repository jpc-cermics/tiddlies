\nspcomment{//An example with a random set of points}
\nspkeyword{function} \nspfunction{test}(X,Y)
  Tr=mesh2d(X,Y)\nspoperator{;}
  plot2d(X,Y,[\nspoperator{-}\nspnumber{1}\nspoperator{,}\nspoperator{-}\nspnumber{2}\nspoperator{,}\nspnumber{3}])\nspoperator{;}
  [m,n]=size(Tr)\nspoperator{;}
  xpols=matrix(X(Tr),m,n)\nspoperator{;}
  ypols=matrix(Y(Tr),m,n)\nspoperator{;}
  xset(\nspstring{"colormap"},rand(\nspnumber{2}\nspoperator{*}n,\nspnumber{3}))\nspoperator{;}
  xfpolys(xpols,ypols,[n\nspoperator{/}\nspnumber{4}\nspoperator{:}n\nspoperator{/}\nspnumber{4}\nspoperator{+}n\nspoperator{-}\nspnumber{1}])\nspoperator{;}
\nspkeyword{endfunction}
N=\nspnumber{1000}\nspoperator{;}xbasc()\nspoperator{;}X=rand(\nspnumber{1},N)\nspoperator{;}Y=rand(\nspnumber{1},N)\nspoperator{;}
xset(\nspstring{"wdim"},\nspnumber{700},\nspnumber{700})\nspoperator{;}
test(X,Y)\nspoperator{;}
