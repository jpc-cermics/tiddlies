\begin{Verbatim}[commandchars=\\\{\}]
set(\nspstring{"figure_style"},\nspstring{"new"})\nspoperator{,}\nspcomment{// select entity based graphics}
f=get(\nspstring{"current_figure"})\nspoperator{,}\nspcomment{// handle of the current figure}
drawlater()
subplot(\nspnumber{221})\nspoperator{;}
t=\nspnumber{1}\nspoperator{:}\nspnumber{10}\nspoperator{;}plot2d(t,t\nspoperator{ .^}\nspnumber{2})
subplot(\nspnumber{222})\nspoperator{;}
x=\nspnumber{0}\nspoperator{:}\nspnumber{1}\nspoperator{:}\nspnumber{7}\nspoperator{;}plot2d(x,cos(x),\nspnumber{2})
subplot(\nspnumber{234})\nspoperator{;}
plot2d(t,cos(t),\nspnumber{3})\nspoperator{;}
subplot(\nspnumber{235})\nspoperator{;}
plot2d(x,sin(\nspnumber{2}\nspoperator{*}x),\nspnumber{5})\nspoperator{;}
subplot(\nspnumber{236})\nspoperator{;}
plot2d(t,tan(\nspnumber{2}\nspoperator{*}t))\nspoperator{;}
draw(gca())\nspoperator{;}\nspcomment{//draw the current axes and its children}
draw(f.children([\nspnumber{3}\nspoperator{,}\nspnumber{4}]))\nspoperator{;}\nspcomment{// draw the specified axes and their children}
drawnow()\nspoperator{;}\nspcomment{// draw the current figure}
\end{Verbatim}
