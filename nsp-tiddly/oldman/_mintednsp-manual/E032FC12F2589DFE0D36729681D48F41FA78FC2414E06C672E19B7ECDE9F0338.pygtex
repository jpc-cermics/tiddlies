\begin{Verbatim}[commandchars=\\\{\}]
l=list(\nspnumber{1},\nspstring{'qwerw'},%s)
l(\nspnumber{1})=\nspstring{'Changed'}
l(\nspnumber{0})=\nspstring{'Added'}
l(\nspnumber{6})=[\nspstring{'one more'}\nspoperator{;}\nspstring{'added'}]
\nspcomment{//}
a=hypermat([\nspnumber{2}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{2}],rand(\nspnumber{1}\nspoperator{:}\nspnumber{2}\nspoperator{^}\nspnumber{3}))\nspoperator{;}\nspcomment{// hypermatrices are coded using mlists}
setfield(\nspnumber{3},\nspnumber{1}\nspoperator{:}\nspnumber{8},a)\nspoperator{;}a\nspoperator{,}\nspcomment{// set the field value to 1:8}
