\begin{Verbatim}[commandchars=\\\{\}]
pathconvert(\nspstring{'SCI/macros\nspbs{}util/foo.sci'},%f,%f,\nspstring{'u'})
pathconvert(\nspstring{'SCI/macros\nspbs{}util/foo.sci'},%f,%f,\nspstring{'w'})
pathconvert(\nspstring{'SCI/macros/util/foo.sci'},%f,%t,\nspstring{'w'})
pathconvert(\nspstring{'HOME/macros/util/foo.sci'},%t,%t,\nspstring{'w'})
pathconvert(\nspstring{'c:/tmp'},%f,%t,\nspstring{'u'})
pathconvert(\nspstring{'/cygdrive/c/tmp'},%f,%f,\nspstring{'w'})
\end{Verbatim}
