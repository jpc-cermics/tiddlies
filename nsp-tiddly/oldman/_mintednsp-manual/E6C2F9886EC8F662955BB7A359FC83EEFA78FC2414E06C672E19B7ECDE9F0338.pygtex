\begin{Verbatim}[commandchars=\\\{\}]
h=figure()\nspoperator{;}
\nspcomment{// creates  figure number 1.}
uicontrol(h,\nspstring{'style'},\nspstring{'text'},\nspstring{'string'},\nspstring{'scilab is great'},\nspstring{'position'},[\nspnumber{50}\nspoperator{,}\nspnumber{70}\nspoperator{,}\nspnumber{100}\nspoperator{,}\nspnumber{100}], ...
          \nspstring{'fontsize'},\nspnumber{15})\nspoperator{;}
\nspcomment{// put a clever text in figure 1}
figure()\nspoperator{;}
\nspcomment{// create figure 2}
uicontrol(\nspstring{'style'},\nspstring{'text'},\nspstring{'string'},\nspstring{'Really great'},\nspstring{'position'},[\nspnumber{50}\nspoperator{,}\nspnumber{70}\nspoperator{,}\nspnumber{100}\nspoperator{,}\nspnumber{100}],\nspstring{'fontsize'},\nspnumber{15})\nspoperator{;}
\nspcomment{// put a text in figure 2}
close()\nspoperator{;}
\nspcomment{// close the current graphic window (ie fig. 2)}
close(h)\nspoperator{;}
\nspcomment{// close figure 1}
\end{Verbatim}
