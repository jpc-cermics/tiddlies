\begin{Verbatim}[commandchars=\\\{\}]
set(\nspstring{"figure_style"},\nspstring{"new"})\nspoperator{,}\nspcomment{//create a figure}
a=get(\nspstring{"current_axes"})\nspoperator{;}\nspcomment{//get the handle of the newly created axes}
a.data_bounds=[\nspoperator{-}\nspnumber{10}\nspoperator{,}\nspoperator{-}\nspnumber{10}\nspoperator{;}\nspnumber{10}\nspoperator{,}\nspnumber{10}]\nspoperator{;}
champ(\nspoperator{-}\nspnumber{5}\nspoperator{:}\nspnumber{5},\nspoperator{-}\nspnumber{5}\nspoperator{:}\nspnumber{5},rand(\nspnumber{11},\nspnumber{11}),rand(\nspnumber{11},\nspnumber{11}))
c=a.children
c.colored=\nspstring{"on"}\nspoperator{;}
c.thickness=\nspnumber{2}\nspoperator{;}
a.data_bounds=[\nspoperator{-}\nspnumber{5}\nspoperator{,}\nspoperator{-}\nspnumber{5}\nspoperator{;}\nspnumber{5}\nspoperator{,}\nspnumber{5}]\nspoperator{;}
