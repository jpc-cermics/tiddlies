\begin{Verbatim}[commandchars=\\\{\}]
n=\nspnumber{64}\nspoperator{;}
r=linspace(\nspnumber{0},\nspnumber{1},n)\nspoperator{'}\nspoperator{;}
g=linspace(\nspnumber{1},\nspnumber{0},n)\nspoperator{'}\nspoperator{;}
b=ones(r)\nspoperator{;}
cmap=[r\nspoperator{,}g\nspoperator{,}b]\nspoperator{;}
f=gcf()\nspoperator{;}f.color_map=cmap\nspoperator{;}
plot3d1()
f.color_map=get(sdf(),\nspstring{"color_map"})\nspoperator{;}
\end{Verbatim}
