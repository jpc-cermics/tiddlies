\begin{Verbatim}[commandchars=\\\{\}]
\nspcomment{//simple plot}
x=[\nspnumber{0}\nspoperator{:}\nspnumber{0.1}\nspoperator{:}\nspnumber{2}\nspoperator{*}%pi]\nspoperator{'}\nspoperator{;}
plot2d(sin(x))
xbasc()
plot2d(x,sin(x))
\nspcomment{//multiple plot}
xbasc()
plot2d(x,[sin(x)\nspoperator{,}sin(\nspnumber{2}\nspoperator{*}x)\nspoperator{,}sin(\nspnumber{3}\nspoperator{*}x)])
\nspcomment{// multiple plot giving the dimensions of the frame}
\nspcomment{// old syntax and new syntax}
xbasc()
plot2d(x,[sin(x)\nspoperator{,}sin(\nspnumber{2}\nspoperator{*}x)\nspoperator{,}sin(\nspnumber{3}\nspoperator{*}x)],\nspnumber{1}\nspoperator{:}\nspnumber{3},\nspstring{"011"},\nspstring{""},[\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{0.5}])
xbasc()
plot2d(x,[sin(x)\nspoperator{,}sin(\nspnumber{2}\nspoperator{*}x)\nspoperator{,}sin(\nspnumber{3}\nspoperator{*}x)],rect = [\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{6}\nspoperator{,}\nspnumber{0.5}])
\nspcomment{//multiple plot with captions and given tics // old syntax and new syntax}
xbasc()
plot2d(x,[sin(x)\nspoperator{,}sin(\nspnumber{2}\nspoperator{*}x)\nspoperator{,}sin(\nspnumber{3}\nspoperator{*}x)],[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{3}],\nspstring{"111"},\nspstring{"L1@L2@L3"},[\nspnumber{0}\nspoperator{,}\nspoperator{-}\nspnumber{2}\nspoperator{,}\nspnumber{2}\nspoperator{*}%pi\nspoperator{,}\nspnumber{2}],[\nspnumber{2}\nspoperator{,}\nspnumber{10}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{10}])\nspoperator{;}
xbasc()
plot2d(x,[sin(x)\nspoperator{,}sin(\nspnumber{2}\nspoperator{*}x)\nspoperator{,}sin(\nspnumber{3}\nspoperator{*}x)],[\nspnumber{1}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{3}],leg = \nspstring{"L1@L2@L3"},nax = [\nspnumber{2}\nspoperator{,}\nspnumber{10}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{10}], ...
       rect = [\nspnumber{0}\nspoperator{,}\nspoperator{-}\nspnumber{2}\nspoperator{,}\nspnumber{2}\nspoperator{*}%pi\nspoperator{,}\nspnumber{2}])
\nspcomment{// isoview}
xbasc()
plot2d(x,sin(x),\nspnumber{1},\nspstring{"041"})
\nspcomment{// scale}
xbasc()
plot2d(x,sin(x),\nspnumber{1},\nspstring{"061"})
\nspcomment{// auto scaling with previous plots}
xbasc()
plot2d(x,sin(x),\nspnumber{1})
plot2d(x,\nspnumber{2}\nspoperator{*}sin(x),\nspnumber{2})
plot2d(\nspnumber{2}\nspoperator{*}x,cos(x),\nspnumber{3})
\nspcomment{// axis on the right}
xbasc()
plot2d(x,sin(x),\nspnumber{1},\nspstring{"183"},\nspstring{"sin(x)"})
\nspcomment{// centered axis}
xbasc()
plot2d(x,sin(x),\nspnumber{1},\nspstring{"184"},\nspstring{"sin(x)"})
\nspcomment{// axis centered at (0,0)}
xbasc()
plot2d(x\nspoperator{-}\nspnumber{4},sin(x),\nspnumber{1},\nspstring{"185"},\nspstring{"sin(x)"})
\end{Verbatim}
