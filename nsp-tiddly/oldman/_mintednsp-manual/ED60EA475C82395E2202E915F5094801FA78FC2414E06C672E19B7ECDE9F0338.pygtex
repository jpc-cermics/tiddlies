\begin{Verbatim}[commandchars=\\\{\}]
rgb2name(\nspnumber{255},\nspnumber{128},\nspnumber{128})
rgb2name([\nspnumber{255}\nspoperator{,}\nspnumber{215}\nspoperator{,}\nspnumber{0}])
\nspcomment{// get color \nspsh{}10 of the current colormap and find its name}
cmap=get(gcf(),\nspstring{"color_map"})\nspoperator{;}
rgb2name(cmap(\nspnumber{10},\nspoperator{:})\nspoperator{*}\nspnumber{255})
\end{Verbatim}
