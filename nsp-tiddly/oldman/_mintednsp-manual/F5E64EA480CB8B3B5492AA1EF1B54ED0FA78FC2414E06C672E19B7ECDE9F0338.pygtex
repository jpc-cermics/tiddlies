h=syslin(\nspstring{'c'},(s\nspoperator{^}\nspnumber{2}\nspoperator{+}\nspnumber{2}\nspoperator{*}\nspnumber{0.9}\nspoperator{*}\nspnumber{10}\nspoperator{*}s\nspoperator{+}\nspnumber{100})\nspoperator{/}(s\nspoperator{^}\nspnumber{2}\nspoperator{+}\nspnumber{2}\nspoperator{*}\nspnumber{0.3}\nspoperator{*}\nspnumber{10.1}\nspoperator{*}s\nspoperator{+}\nspnumber{102.01}))
h1=h\nspoperator{*}syslin(\nspstring{'c'},(s\nspoperator{^}\nspnumber{2}\nspoperator{+}\nspnumber{2}\nspoperator{*}\nspnumber{0.1}\nspoperator{*}\nspnumber{15.1}\nspoperator{*}s\nspoperator{+}\nspnumber{228.01})\nspoperator{/}(s\nspoperator{^}\nspnumber{2}\nspoperator{+}\nspnumber{2}\nspoperator{*}\nspnumber{0.9}\nspoperator{*}\nspnumber{15}\nspoperator{*}s\nspoperator{+}\nspnumber{225}))
