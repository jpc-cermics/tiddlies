\begin{Verbatim}[commandchars=\\\{\}]
x=[\nspoperator{-}\nspnumber{0.3}\nspoperator{:}\nspnumber{0.8}\nspoperator{:}\nspnumber{27.3}]\nspoperator{'}\nspoperator{;}
y=rand(x)\nspoperator{;}
rect=[min(x)\nspoperator{,}min(y)\nspoperator{,}max(x)\nspoperator{,}max(y)]\nspoperator{;}
tics=[\nspnumber{4}\nspoperator{,}\nspnumber{10}\nspoperator{,}\nspnumber{2}\nspoperator{,}\nspnumber{5}]\nspoperator{;}\nspcomment{//4 x-intervals and 2 y-intervals}
plotframe(rect,tics,[%f\nspoperator{,}%f],[\nspstring{"My plot"}\nspoperator{,}\nspstring{"x"}\nspoperator{,}\nspstring{"y"}],[\nspnumber{0}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0.5}\nspoperator{,}\nspnumber{0.5}])
plot2d(x,y,\nspnumber{2},\nspstring{"000"})
plotframe(rect,tics,[%t\nspoperator{,}%f],[\nspstring{"My plot with grids"}\nspoperator{,}\nspstring{"x"}\nspoperator{,}\nspstring{"y"}],[\nspnumber{0.5}\nspoperator{,}\nspnumber{0}\nspoperator{,}\nspnumber{0.5}\nspoperator{,}\nspnumber{0.5}])
plot2d(x,y,\nspnumber{3},\nspstring{"000"})
plotframe(rect,tics,[%t\nspoperator{,}%t],[\nspstring{"My plot with grids and automatic bounds"}\nspoperator{,}\nspstring{"x"}\nspoperator{,}\nspstring{"y"}], ...
          [\nspnumber{0}\nspoperator{,}\nspnumber{0.5}\nspoperator{,}\nspnumber{0.5}\nspoperator{,}\nspnumber{0.5}])
plot2d(x,y,\nspnumber{4},\nspstring{"000"})
plotframe(rect,tics,[%f\nspoperator{,}%t],[\nspstring{"My plot without grids but with automatic bounds"}\nspoperator{,}\nspstring{"x"}\nspoperator{,}\nspstring{"y"}], ...
          [\nspnumber{0.5}\nspoperator{,}\nspnumber{0.5}\nspoperator{,}\nspnumber{0.5}\nspoperator{,}\nspnumber{0.5}])
plot2d(x,y,\nspnumber{5},\nspstring{"000"})
xset(\nspstring{"default"})
\end{Verbatim}
