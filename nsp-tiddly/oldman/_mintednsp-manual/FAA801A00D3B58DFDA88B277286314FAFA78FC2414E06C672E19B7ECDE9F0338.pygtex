\begin{Verbatim}[commandchars=\\\{\}]
plot2d([\nspnumber{0}\nspoperator{;}\nspnumber{1}],[\nspnumber{0}\nspoperator{;}\nspnumber{1}],\nspnumber{0})
xstring(\nspnumber{0.5},\nspnumber{0.5},[\nspstring{"Scilab"}\nspoperator{,}\nspstring{"is"}\nspoperator{;}\nspstring{"not"}\nspoperator{,}\nspstring{"esilaB"}])
\nspcomment{//Other example}
alphabet=[\nspstring{"a"}\nspoperator{,}\nspstring{"b"}\nspoperator{,}\nspstring{"c"}\nspoperator{,}\nspstring{"d"}\nspoperator{,}\nspstring{"e"}\nspoperator{,}\nspstring{"f"}\nspoperator{,}\nspstring{"g"}\nspoperator{,}\nspstring{"h"}\nspoperator{,}\nspstring{"i"}\nspoperator{,}\nspstring{"j"}\nspoperator{,}\nspstring{"k"}\nspoperator{,}\nspstring{"l"}\nspoperator{,}\nspstring{"m"}\nspoperator{,}\nspstring{"n"}\nspoperator{,}\nspstring{"o"}\nspoperator{,}\nspstring{"p"}\nspoperator{,}\nspstring{"q"}\nspoperator{,}\nspstring{"r"}\nspoperator{,}\nspstring{"s"}\nspoperator{,}\nspstring{"t"}\nspoperator{,} ...
          \nspstring{"u"}\nspoperator{,}\nspstring{"v"}\nspoperator{,}\nspstring{"w"}\nspoperator{,}\nspstring{"x"}\nspoperator{,}\nspstring{"y"}\nspoperator{,}\nspstring{"z"}]\nspoperator{;}
xbasc()
plot2d([\nspnumber{0}\nspoperator{;}\nspnumber{1}],[\nspnumber{0}\nspoperator{;}\nspnumber{2}],\nspnumber{0})
xstring(\nspnumber{0.1},\nspnumber{1.8},alphabet)\nspoperator{,}\nspcomment{// alphabet}
xstring(\nspnumber{0.1},\nspnumber{1.6},alphabet,\nspnumber{0},\nspnumber{1})\nspoperator{,}\nspcomment{// alphabet in a box}
xstring(\nspnumber{0.1},\nspnumber{1.4},alphabet,\nspnumber{20})\nspoperator{,}\nspcomment{// angle}
xset(\nspstring{"font"},\nspnumber{1},\nspnumber{1})\nspoperator{,}\nspcomment{// use symbol fonts}
xstring(\nspnumber{0.1},\nspnumber{0.1},alphabet)
xset(\nspstring{"font"},\nspnumber{1},\nspnumber{3})\nspoperator{,}\nspcomment{// change size font}
xstring(\nspnumber{0.1},\nspnumber{0.3},alphabet)
xset(\nspstring{"font"},\nspnumber{1},\nspnumber{24})\nspoperator{;}xstring(\nspnumber{0.1},\nspnumber{0.6},\nspstring{"a"})\nspoperator{,}\nspcomment{//big alpha}
xset(\nspstring{"default"})
