\begin{Verbatim}[commandchars=\\\{\}]
[xc,yc]=contour2di(\nspnumber{1}\nspoperator{:}\nspnumber{10},\nspnumber{1}\nspoperator{:}\nspnumber{10},rand(\nspnumber{10},\nspnumber{10}),\nspnumber{5})\nspoperator{;}
k=\nspnumber{1}\nspoperator{;}n=yc(k)\nspoperator{;}c=\nspnumber{1}\nspoperator{;}
\nspkeyword{while} k\nspoperator{+}yc(k)\nspoperator{ < }size(xc,\nspstring{'*'}) \nspkeyword{do}
  n=yc(k)\nspoperator{;}
  plot2d(xc(k\nspoperator{+}(\nspnumber{1}\nspoperator{:}n)),yc(k\nspoperator{+}(\nspnumber{1}\nspoperator{:}n)),c)
  c=c\nspoperator{+}\nspnumber{1}\nspoperator{;}
  k=k\nspoperator{+}n\nspoperator{+}\nspnumber{1}\nspoperator{;}
\nspkeyword{end}
