function [At,b,c,K]=specfac(b)
  m=length(b);
  c= diag([m-1:-1:0]);
  c= sparse(c(:));
  e =ones(m,1);
  At = sparse([],[],[m^2,m]);
  for k=1:m 
    xx= diag(e,k-1);
    xx=xx(1:m,1:m)
    At(:,k)= sparse(xx(:));
  end
  K.s=m
endfunction;
b=[2;0.2;-0.3];
