function [At,b,c,K]=rls(P,q)
  [m,n]=size(P)
  b = -sparse([1;1;zeros(n,1)]);
  
  At = [-1,zeros(1,n+1);
zeros(m,2),P];
  c=[0;q];
  K.q = 1+m;
  At=[At; 0,-1,zeros(1,n);
      zeros(1,n+2);
      zeros(n,2),-eye(n,n)];
  At= sparse(At);
  c = sparse([c;0;1;zeros(n,1)]);
  K.q = [K.q,2+n];
endfunction;
